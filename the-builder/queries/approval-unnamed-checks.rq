# The checks a release approval's candidate was given that no wanted item the
# approval names is proved by: each with its result on the candidate and its
# canary's result. They are shown so no check is left off the page. ?step is bound
# by the caller.
PREFIX earl:    <http://www.w3.org/ns/earl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX p-plan:  <http://purl.org/net/p-plan#>
PREFIX xc:      <https://drift-king.org/ah/x-components/0.2.0/>

SELECT ?step ?check ?realFound ?realVerdict ?detail ?canaryFound ?canaryVerdict WHERE {
  ?step p-plan:hasInputVar ?var .
  ?doc p-plan:correspondsToVariable ?var ;
    dcterms:conformsTo <https://spec.commonmark.org/> ;
    dcterms:references ?candidate .
  ?real a earl:Assertion ;
    earl:assertedBy ?realBy ;
    earl:subject ?candidate ;
    earl:test ?test ;
    earl:result ?realResult .
  ?realResult earl:outcome ?realOutcome .
  FILTER (?realBy IN (<https://drift-king.org/ah/the-builder>, xc:release-checker))
  ?test dcterms:title ?check ;
    dcterms:relation ?canarySubject .
  FILTER NOT EXISTS { ?test dcterms:relation ?candidate }
  FILTER NOT EXISTS { ?doc dcterms:references ?want . ?want dcterms:references ?test }
  OPTIONAL { ?realResult dcterms:description ?detail }
  BIND (IF(?realOutcome = earl:failed, "something", "nothing") AS ?realFound)
  BIND (IF(?realOutcome = earl:passed, "As it must.", "Not as it must.") AS ?realVerdict)
  OPTIONAL {
    ?canary a earl:Assertion ;
      earl:subject ?canarySubject ;
      earl:test ?test ;
      earl:result [ earl:outcome ?canaryOutcome ] .
    BIND (IF(?canaryOutcome = earl:failed, "something", "nothing") AS ?canaryFound)
    BIND (IF(?canaryOutcome = earl:failed, "As it must.", "Not as it must.") AS ?canaryVerdict)
  }
}
ORDER BY ?check
