<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{head.title}}</title>
<meta name="description" content="{{head.description}}">
<link rel="stylesheet" href="/console.css">
</head>
<body>
<x-header brand="{{header.brand}}"></x-header>
<x-console>
<x-side-nav label="{{nav.label}}">
<x-side-nav-item href="/console/" label="{{nav.intents}}" current></x-side-nav-item>
</x-side-nav>
<x-section as="div">
<x-page-heading title="{{heading.title}}" blurb="{{heading.blurb}}"></x-page-heading>
<x-section as="section">
<x-heading compact>{{agreements.heading}}</x-heading>
{{#rows}}{{^isGap}}<x-card as="article">
<x-heading compact>{{title}}</x-heading>
<x-tag label="{{words.agreement}}"></x-tag>
<x-terms>
<x-term><x-term-name>{{words.status}}</x-term-name><x-term-body>{{#open}}{{words.open}}{{/open}}{{#done}}{{words.done}}{{/done}} ({{asksMet}} {{words.of}} {{asksTotal}} {{words.asks_met}})</x-term-body></x-term>
<x-term><x-term-name>{{words.asks}}</x-term-name><x-term-body><x-prose>{{quote}}</x-prose><x-link href="{{quoteHref}}" label="{{words.signed_file}}"></x-link></x-term-body></x-term>
<x-term><x-term-name>{{words.fulfilled_by}}</x-term-name><x-term-body>{{#fulfilledBy}}<x-link href="{{fulfilledBy}}" label="{{words.fulfilment}}"></x-link>{{/fulfilledBy}}{{^fulfilledBy}}{{words.not_met}}{{/fulfilledBy}}</x-term-body></x-term>
<x-term><x-term-name>{{words.signed}}</x-term-name><x-term-body>{{signedAt}} {{words.envelope}} {{envelope}}</x-term-body></x-term>
</x-terms>
</x-card>
{{/isGap}}{{/rows}}</x-section>
<x-section as="section" divider>
<x-heading compact>{{gaps.heading}}</x-heading>
{{#rows}}{{#isGap}}<x-card as="article">
<x-heading compact>{{title}}</x-heading>
<x-tag label="{{words.gap}}"></x-tag>
<x-terms>
<x-term><x-term-name>{{words.status}}</x-term-name><x-term-body>{{words.open}}</x-term-body></x-term>
<x-term><x-term-name>{{words.answers}}</x-term-name><x-term-body><x-prose>{{quote}}</x-prose><x-link href="{{quoteHref}}" label="{{words.the_letter}}"></x-link></x-term-body></x-term>
<x-term><x-term-name>{{words.closed_by}}</x-term-name><x-term-body><x-link href="{{test}}" label="{{words.the_check}}"></x-link></x-term-body></x-term>
</x-terms>
</x-card>
{{/isGap}}{{/rows}}</x-section>
</x-section>
</x-console>
<x-footer brand="{{footer.brand}}" blurb="{{footer.blurb}}" copyright="{{footer.copyright}}"></x-footer>
</body>
</html>
