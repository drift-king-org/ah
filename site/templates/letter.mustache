<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<link rel="stylesheet" href="/style.css">
<link rel="icon" href="https://pid1.drift-king.org/favicon.ico">
</head>
<body>
<nav class="nav"><a class="wm" href="/" style="text-decoration:none">Drift King</a></nav>
<main class="plain">
<h1>{{title}}</h1>
<div class="letter">
{{#paragraphs}}<p>{{text}}</p>
{{/paragraphs}}</div>
{{#rows}}<p class="proof">Signed by the lead architect on {{signed_on}}, DocuSign envelope {{envelope}}.<br>
<a href="{{signed_url}}">The letter as signed in DocuSign</a> (PDF), sha256 {{signed_sha256}}</p>
{{/rows}}</main>
</body>
</html>
