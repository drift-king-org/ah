{
  // drift-king.org: files only, no script. Everything under public/ is
  // generated by the-builder from the model and the commit. A path with no
  // file gets public/404.html with status 404, never another service's answer.
  "name": "drift-king-site",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "routes": [{ "pattern": "drift-king.org", "custom_domain": true }],
  "assets": { "directory": "./public", "not_found_handling": "404-page" }
}
