# Audits @apricotter/x-components' own model, loaded on its own: no label or
# comment in it names another repository, a file of someone else's, a product,
# a person's role, a date, or the private apr: vocabulary. A sample of words,
# not a proof; the producer's own check scrubs every file.
SELECT ?subject ?text WHERE {
  ?subject ?property ?text .
  FILTER (isLiteral(?text) && strstarts(str(?subject), "https://apricotter.com/ns/"))
  FILTER (regex(str(?text), "shop ?watch|claude|microsites|drift-king|rep console|ontology/|lint-|designer|apr:|[0-9]{4}-[0-9]{2}-[0-9]{2}", "i"))
}
ORDER BY ?subject
