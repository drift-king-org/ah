# A canary is fake data built to make one check fire. Loaded next to the real
# model it can hide a real finding or invent a false one, and nothing would
# say so. So no step may take a canary and a model file as inputs together.
#
# A canary file is anything the-linter asserts must fail (its EARL assertion,
# outcome failed). A model file is any owl:Ontology in our own namespace
# (ah.ttl, not-ah.ttl). Both are read from the model, never listed here.
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX vann:   <http://purl.org/vocab/vann/>
PREFIX earl:   <http://www.w3.org/ns/earl#>
PREFIX p-plan: <http://purl.org/net/p-plan#>

SELECT DISTINCT ?found WHERE {
  <https://drift-king.org/ah.ttl> vann:preferredNamespaceUri ?base .

  # Asserted by the-linter, as the header says. A gap is a failed assertion
  # too, but an agent's statement about the real model, never a canary.
  ?assertion a earl:Assertion ;
    earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
    earl:subject ?canary ;
    earl:result [ earl:outcome earl:failed ] .

  ?model a owl:Ontology .
  FILTER (strstarts(str(?model), str(?base)))
  FILTER (?model != ?canary)

  ?step a p-plan:Step ;
    p-plan:hasInputVar ?canaryVar , ?modelVar .
  ?canary p-plan:correspondsToVariable ?canaryVar .
  ?model  p-plan:correspondsToVariable ?modelVar .

  BIND (concat(str(?step), " reads canary ", str(?canary), " with model ", str(?model)) AS ?found)
}
ORDER BY ?found
