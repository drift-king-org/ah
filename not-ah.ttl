<https://drift-king.org/not-ah/the-linter/derive-provenance>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/not-ah/the-linter/var/kept-x-components> ;
    dcterms:title "derive what the kept x-components 0.1.0 attestations say, from the committed bytes, and compare it with the committed provenance.ttl" ;
    sd:hasExecutionCommand """cd vendor/npm/apricotter-x-components/0.1.0 && d=$(mktemp -d) && git show HEAD:./x-components-0.1.0.tgz > "$d/x-components-0.1.0.tgz" && git show HEAD:./attestations.json > "$d/attestations.json" && git show HEAD:./provenance.ttl > "$d/committed.ttl" && (cd "$d" && node -e 'const fs=require("fs"),c=require("crypto"),Q=String.fromCharCode(34),N=String.fromCharCode(10);const [tgz,att]=process.argv.slice(1);const B="https://drift-king.org/vendor/npm/apricotter-x-components/0.1.0/";const I=x=>"<"+x+">";const S=x=>Q+x+Q;const L=["@prefix owl:     <http://www.w3.org/2002/07/owl#> .","@prefix prov:    <http://www.w3.org/ns/prov#> .","@prefix dcterms: <http://purl.org/dc/terms/> .","",I(B+"provenance.ttl")+" a owl:Ontology , prov:Entity ;","    prov:wasDerivedFrom "+I(B+tgz)+" , "+I(B+att)+" .",I(B+tgz)+" dcterms:identifier "+S("sha512-"+c.createHash("sha512").update(fs.readFileSync(tgz)).digest("base64"))+" ."];JSON.parse(fs.readFileSync(att,"utf8")).attestations.forEach((a,i)=>{const s=JSON.parse(Buffer.from(a.bundle.dsseEnvelope.payload,"base64").toString("utf8"));const n=I(B+att+"#"+(i+1));L.push("",n+" a prov:Entity ;","    dcterms:conformsTo "+I(s.predicateType)+" ;","    dcterms:subject "+S("sha512-"+Buffer.from(s.subject[0].digest.sha512,"hex").toString("base64"))+" ;");a.bundle.verificationMaterial.tlogEntries.forEach(t=>L.push("    dcterms:identifier "+S("rekor:"+t.logIndex)+" ;"));const d=s.predicate&&s.predicate.buildDefinition;if(d){L.push("    prov:wasGeneratedBy "+I(B+att+"#"+(i+1)+"-build")+" .",I(B+att+"#"+(i+1)+"-build")+" a prov:Activity ;","    prov:used "+I(d.externalParameters.workflow.repository+"/commit/"+d.resolvedDependencies[0].digest.gitCommit)+" .")}else{L[L.length-1]=L[L.length-1].replace(/ ;$/," .")}});process.stdout.write(L.join(N)+N);' x-components-0.1.0.tgz attestations.json > derived.ttl) && cmp "$d/derived.ttl" "$d/committed.ttl"; r=$?; rm -rf "$d"; exit $r""" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .

