@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sd:      <https://w3id.org/okn/o/sd#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix earl:    <http://www.w3.org/ns/earl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# This document. Not the catalog it describes: that has its own IRI below.
<https://drift-king.org/not-ah.ttl>
    a owl:Ontology , prov:Entity ;
    # DCAT by its real name. Fetched from w3.org for now.
    owl:imports <http://www.w3.org/ns/dcat> ,
        # DCMI Terms by its real name, for dcterms:requires and the rest.
        <http://purl.org/dc/terms/> ,
        # SDO by its real name, for sd:hasExecutionCommand and sd:SoftwareVersion.
        <https://w3id.org/okn/o/sd> ,
        # What the kept x-components 0.1.0 tarball's provenance says, derived
        # from the kept files by the-builder and compared on every build.
        <https://drift-king.org/vendor/npm/apricotter-x-components/0.1.0/provenance.ttl> .

# The other half. Same shape as ah, opposite membership. Holds the tool pins
# cloudflare-pid-rs (and anything else ah requires) actually runs on: each is
# added here once installed and its version confirmed, never staged ahead of
# that — an entry here is a claim that this exact pin was seen to work.
<https://drift-king.org/not-ah>
    a dcat:Catalog ;
    dcterms:title "not-everything" ;
    # Its own linter, the way ah-workbench's not-ah requires its own. The
    # linter checks not-ah too: nothing is exempt.
    dcterms:requires <https://drift-king.org/not-ah/the-linter> .

# What not-ah's toolchain pins are. Ours to name; each points at the exact
# release its version command was seen to print. Confirmed working, not
# staged ahead of that.
<https://drift-king.org/not-ah/rustc>
    a sd:SoftwareVersion ;
    sd:name "rustc" ;
    sd:hasVersionId "1.98.1" ;
    dcterms:source <https://github.com/rust-lang/rust/releases/tag/1.98.1> .

<https://drift-king.org/not-ah/cargo-zigbuild>
    a sd:SoftwareVersion ;
    sd:name "cargo-zigbuild" ;
    sd:hasVersionId "0.23.0" ;
    dcterms:source <https://github.com/rust-cross/cargo-zigbuild/releases/tag/v0.23.0> .

# ziglang/zig has no GitHub tag or release for 0.16.0 as of this dig — its
# tag list tops out at 0.15.2. Sourced from Zig's own release notes instead
# of a fabricated GitHub tag; installed via the PyPI wheel, which is what
# python -m ziglang actually runs.
<https://drift-king.org/not-ah/zig>
    a sd:SoftwareVersion ;
    sd:name "zig" ;
    sd:hasVersionId "0.16.0" ;
    sd:hasDownloadURL "https://pypi.org/project/ziglang/0.16.0/"^^xsd:anyURI ;
    dcterms:source <https://ziglang.org/download/0.16.0/release-notes.html> .

# What makes a build without Docker possible: a client-only OCI tool.
# Downloaded as go-containerregistry_Windows_x86_64.tar.gz and checked
# against that release's own checksums.txt before it was ever run.
<https://drift-king.org/not-ah/crane>
    a sd:SoftwareVersion ;
    sd:name "crane" ;
    sd:hasVersionId "0.22.1" ;
    sd:hasDownloadURL "https://github.com/google/go-containerregistry/releases/download/v0.22.1/go-containerregistry_Windows_x86_64.tar.gz"^^xsd:anyURI ;
    dcterms:source <https://github.com/google/go-containerregistry/releases/tag/v0.22.1> .

<https://drift-king.org/not-ah/wrangler>
    a sd:SoftwareVersion ;
    sd:name "wrangler" ;
    sd:hasVersionId "4.145.0" ;
    sd:hasDownloadURL "https://www.npmjs.com/package/wrangler/v/4.145.0"^^xsd:anyURI ;
    dcterms:source <https://github.com/cloudflare/workers-sdk/releases/tag/wrangler%404.145.0> .

# nix-rust/nix publishes no GitHub releases at all ("There aren't any
# releases here") — crates.io is the real, verifiable distribution point,
# so it stands in for both source and download, same call as for zig.
<https://drift-king.org/not-ah/crate/nix>
    a sd:SoftwareVersion ;
    sd:name "nix" ;
    sd:hasVersionId "0.29.0" ;
    sd:hasDownloadURL "https://crates.io/crates/nix/0.29.0"^^xsd:anyURI ;
    dcterms:source <https://crates.io/crates/nix/0.29.0> ;
    rdfs:comment "Cargo features enabled: signal, process." .

<https://drift-king.org/not-ah/crate/libc>
    a sd:SoftwareVersion ;
    sd:name "libc" ;
    sd:hasVersionId "0.2.189" ;
    sd:hasDownloadURL "https://crates.io/crates/libc/0.2.189"^^xsd:anyURI ;
    dcterms:source <https://github.com/rust-lang/libc/releases/tag/0.2.189> .

<https://drift-king.org/not-ah/crate/serde_json>
    a sd:SoftwareVersion ;
    sd:name "serde_json" ;
    sd:hasVersionId "1.0.151" ;
    sd:hasDownloadURL "https://crates.io/crates/serde_json/1.0.151"^^xsd:anyURI ;
    dcterms:source <https://github.com/serde-rs/json/releases/tag/v1.0.151> ;
    rdfs:comment "Parses ast-grep's --json=compact output and reads the code-scope/publish-copies query results' data shape where needed. Added in M3.6, named here now -- a real gap, caught by named-by-nobody in spirit even though it only checks files, not Cargo.toml entries." .

<https://drift-king.org/not-ah/crate/mustache>
    a sd:SoftwareVersion ;
    sd:name "mustache" ;
    sd:hasVersionId "0.9.0" ;
    sd:hasDownloadURL "https://crates.io/crates/mustache/0.9.0"^^xsd:anyURI ;
    dcterms:source <https://github.com/nickel-org/rust-mustache/releases/tag/v0.9.0> ;
    rdfs:comment "Chosen by running it against not-ah/mustache-spec: 123/123 non-partial tests pass (comments, delimiters minus its two partial-behavior cases, interpolation, inverted, sections -- every feature index.mustache and letter.mustache actually use). Partials are untested: neither template uses {{> }}." .

<https://drift-king.org/not-ah/crate/yaml-rust2>
    a sd:SoftwareVersion ;
    sd:name "yaml-rust2" ;
    sd:hasVersionId "0.13.0" ;
    sd:hasDownloadURL "https://crates.io/crates/yaml-rust2/0.13.0"^^xsd:anyURI ;
    dcterms:source <https://github.com/Ethiraric/yaml-rust2/releases/tag/v0.13.0> ;
    dcterms:identifier "sha256:57e5b818a27a4cd30884ea380857a5e56f7ec3ba24a3990a3cc0b95af3238e18" ;
    rdfs:comment "Reads a page's copy (YAML 1.2) so a render step can give it to a template, as it gives a query's rows or a CommonMark text. Chosen because it is a YAML 1.2 parser with no code of its own to run, and with default features off it brings no encoding crate. The sha256 is the crate file's, as crates.io records it." .

# ---------------------------------------------------------------------------
# The official Mustache spec (M3.7), vendored the same way the vocabularies
# are: pinned to one tag, sha256 per file, read from disk, never fetched at
# render time. Only the six core spec files -- ~lambdas, ~dynamic-names and
# ~inheritance are optional extensions this project doesn't use.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/mustache-spec>
    a dcat:Dataset ;
    dcterms:title "Mustache spec v1.4.3" ;
    dcterms:source <https://github.com/mustache/spec/releases/tag/v1.4.3> ;
    dcat:distribution <https://drift-king.org/not-ah/mustache-spec/specs/comments.json> ,
        <https://drift-king.org/not-ah/mustache-spec/specs/delimiters.json> ,
        <https://drift-king.org/not-ah/mustache-spec/specs/interpolation.json> ,
        <https://drift-king.org/not-ah/mustache-spec/specs/inverted.json> ,
        <https://drift-king.org/not-ah/mustache-spec/specs/partials.json> ,
        <https://drift-king.org/not-ah/mustache-spec/specs/sections.json> .
<https://drift-king.org/not-ah/mustache-spec/specs/comments.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/comments.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:e5e07151b538c62d3d00e585ff49e411817ba7eb834267fd5ad67225b6e025b6" .
<https://drift-king.org/not-ah/mustache-spec/specs/delimiters.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/delimiters.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:a5ac3b70e04ecd03f292977e172883a41c97a949201e7d6aa364054148df225e" .
<https://drift-king.org/not-ah/mustache-spec/specs/interpolation.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/interpolation.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:530f691371198333f894a4b7c64cf7bdfd2247dfa04e769202c4c3fc31c28bf1" .
<https://drift-king.org/not-ah/mustache-spec/specs/inverted.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/inverted.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:8c5f81135bfad218ca9a4524221c3199e3b0e82654f9b4686013ca6ef93edaa5" .
<https://drift-king.org/not-ah/mustache-spec/specs/partials.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/partials.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:61b0de5f51b8cb61259a7291aeaa2df26ef8e6b410be1d5ebd39e6e318a1f640" ;
    rdfs:comment "Not required to pass: neither site template uses {{> partial}}." .
<https://drift-king.org/not-ah/mustache-spec/specs/sections.json>
    a dcat:Distribution ; dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://raw.githubusercontent.com/mustache/spec/v1.4.3/specs/sections.json"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:identifier "sha256:f03d109633861186e788d8c63b63a4717635c3049f0d4378aa249dd303c7da82" .

<https://drift-king.org/not-ah/ffmpeg>
    a sd:SoftwareVersion ;
    sd:name "ffmpeg" ;
    sd:hasVersionId "8.0.1" ;
    sd:hasDownloadURL "https://www.gyan.dev/ffmpeg/builds/"^^xsd:anyURI ;
    dcterms:source <https://ffmpeg.org/releases/ffmpeg-8.0.1.tar.xz> .

<https://drift-king.org/not-ah/npm/cloudflare-containers>
    a sd:SoftwareVersion ;
    sd:name "@cloudflare/containers" ;
    sd:hasVersionId "0.3.7" ;
    sd:hasDownloadURL "https://www.npmjs.com/package/@cloudflare/containers/v/0.3.7"^^xsd:anyURI ;
    dcterms:source <https://github.com/cloudflare/containers/releases/tag/v0.3.7> .

# The append step that pushes pid1-layer.tar onto an empty base. Runs
# before mutate, which sets entrypoint/platform/port on what this pushes.
# The registry login. Cloudflare's registry takes only short-lived
# credentials, so every push gets its own: wrangler asks for 30 minutes of
# push and pull, node splits wrangler's JSON into a username line and the
# password, and crane reads the password on stdin. The password passes
# through pipes only. It is never in the model, in a file the builder writes,
# or in the builder's output; crane keeps it in its own config until the
# logout step. Sources: wrangler's registries credentials command (--json
# prints the username and the password) and its own docker login, which
# does the same thing with --password-stdin. If wrangler or node fails, no
# username reaches the read, and the step fails before crane is called.
<https://drift-king.org/not-ah/crane/login>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    # A ship step, like the push it opens: it waits for every check.
    p-plan:isPrecededBy <https://drift-king.org/ah/cloudflare-pid-rs/make-layer> ,
        <https://drift-king.org/not-ah/the-linter/ship-steps-marked/real-step> ;
    dcterms:title "push pid1: log crane in to the registry for 30 minutes" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs/worker && npx --yes wrangler@4.145.0 containers registries credentials --push --pull --expiration-minutes 30 --json | node -e 'const c = JSON.parse(require(\"fs\").readFileSync(0, \"utf8\")); process.stdout.write(c.username + \"\\n\" + c.password)' | { read -r u && [ -n \"$u\" ] && ../.tools/crane/crane.exe auth login registry.cloudflare.com -u \"$u\" --password-stdin; }" ;
    dcterms:references <https://github.com/cloudflare/workers-sdk/blob/main/packages/wrangler/src/containers/registries.ts> ,
        <https://github.com/cloudflare/workers-sdk/blob/main/packages/containers-shared/src/login.ts> ;
    dcterms:requires <https://drift-king.org/not-ah/wrangler> , <https://drift-king.org/not-ah/crane> , <https://drift-king.org/not-ah/node> .

<https://drift-king.org/not-ah/node>
    a sd:SoftwareVersion ;
    sd:name "node" ;
    rdfs:comment "The Node.js npx already runs on. Not pinned yet: its version is the next thing to record." .

<https://drift-king.org/not-ah/crane/append-pid1>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    # A ship step: pushing to the registry waits for every check, and for the
    # login that lets it push.
    p-plan:isPrecededBy <https://drift-king.org/not-ah/crane/login> ;
    dcterms:title "push pid1: append the layer to an empty base" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs && ./.tools/crane/crane.exe append -f pid1-layer.tar --oci-empty-base -t registry.cloudflare.com/${CLOUDFLARE_ACCOUNT_ID:?}/cloudflare-pid-rs:latest" ;
    dcterms:requires <https://drift-king.org/not-ah/setting/cloudflare-account-id> ;
    dcterms:requires <https://drift-king.org/not-ah/crane> .

# The mutate step that sets pid1's entrypoint and exposed port.
# MSYS_NO_PATHCONV=1 is load-bearing: without it, running crane.exe (a
# native Windows binary) from Git Bash rewrites the literal /pid1 argument
# into a Windows path before crane ever sees it. Caught once via the pushed
# config, fixed once, recorded here so it cannot recur silently.
<https://drift-king.org/not-ah/crane/mutate-pid1>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/crane/append-pid1> ;
    p-plan:hasOutputVar <https://drift-king.org/not-ah/crane/var/image> ;
    dcterms:title "push pid1: set entrypoint and exposed port" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs && MSYS_NO_PATHCONV=1 ./.tools/crane/crane.exe mutate registry.cloudflare.com/${CLOUDFLARE_ACCOUNT_ID:?}/cloudflare-pid-rs@sha256:2c0a8cae7dea4943d408233e6c9d19b8781a1da71fc4ae9b6e97d60e64978459 --set-platform linux/amd64 --entrypoint /pid1 --exposed-ports 8080 -t registry.cloudflare.com/${CLOUDFLARE_ACCOUNT_ID:?}/cloudflare-pid-rs:latest" ;
    dcterms:requires <https://drift-king.org/not-ah/setting/cloudflare-account-id> ;
    dcterms:requires <https://drift-king.org/not-ah/crane> .

<https://drift-king.org/not-ah/crane/var/image> a p-plan:Variable ; rdfs:label "the pushed image" .

# The logout: crane forgets the password as soon as the push is done, rather
# than keeping it until it expires.
<https://drift-king.org/not-ah/crane/logout>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/crane/mutate-pid1> ;
    dcterms:title "push pid1: log crane out of the registry" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs && ./.tools/crane/crane.exe auth logout registry.cloudflare.com" ;
    dcterms:requires <https://drift-king.org/not-ah/crane> .

# ---------------------------------------------------------------------------
# the-linter. Its checks are SPARQL files, each proven on a canary before its
# findings count. Not yet wired to run: named first, so the code that runs
# them is written against names that already exist.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter>
    a prov:SoftwareAgent , earl:Assertor .

<https://drift-king.org/the-linter/checks/domain-retypes.rq>
    a dcat:Resource , p-plan:Entity , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "a domain must not retype what the model already typed" .

# Must be caught: a dcat:Dataset carrying dcat:downloadURL, whose domain is
# dcat:Distribution. Must stay clean: the same property on a Distribution.
<https://drift-king.org/the-linter/canaries/domain-retypes.ttl>
    a p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> .

[ a earl:Assertion ;
  earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/the-linter/canaries/domain-retypes.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/domain-retypes.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ] .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/ah.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/domain-retypes.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ] .

# Marks an observation as coming from a disk scan, not from the model
# proper. Whatever runs named-by-nobody.rq injects one of these triples per
# real file found, fresh, every run -- never a kept list.
<https://drift-king.org/not-ah/the-linter/disk-scan>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    rdfs:comment "Not a fact about the repo -- a marker an observation is filed under, so the check can tell an injected disk-scan record from a real model statement." .

<https://drift-king.org/the-linter/checks/named-by-nobody.rq>
    a dcat:Resource , p-plan:Entity , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "every file on disk must be named by the model" .

# Must be caught: an observation whose computed address nothing names.
# Must stay clean: the same shape, but the address is .gitignore, which
# ah.ttl does name.
<https://drift-king.org/the-linter/canaries/named-by-nobody.ttl>
    a p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> .

[ a earl:Assertion ;
  earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/the-linter/canaries/named-by-nobody.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/named-by-nobody.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ] .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/ah.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/named-by-nobody.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ] .

<https://drift-king.org/not-ah/ast-grep>
    a sd:SoftwareVersion ;
    sd:name "ast-grep-cli" ;
    sd:hasVersionId "0.45.3" ;
    sd:hasDownloadURL "https://pypi.org/project/ast-grep-cli/0.45.3/"^^xsd:anyURI ;
    dcterms:source <https://github.com/ast-grep/ast-grep/releases/tag/0.45.3> ;
    rdfs:comment "Same pin ah-workbench already uses. Extracts string literals for the-linter's Rust and JS rules." .

# ---------------------------------------------------------------------------
# The words Rust and JS code are recorded in: tree-sitter's own grammars, as
# ast-grep exposes them. Not an ASDL grammar like CPython publishes --
# tree-sitter's grammar.js is the closest real source of truth for each.
# What each check observes is a whole binary_expression when strings.rq
# joins two literals with +, or a plain literal otherwise -- one class
# either way, since the check only ever wants one value and one line.
# ---------------------------------------------------------------------------
<https://drift-king.org/rust/ast#>
    a owl:NamedIndividual ;
    dcterms:title "tree-sitter-rust grammar, as ast-grep records code in" ;
    vann:preferredNamespacePrefix "rs" ;
    vann:preferredNamespaceUri "https://drift-king.org/rust/ast#" ;
    rdfs:isDefinedBy <https://github.com/tree-sitter/tree-sitter-rust/blob/v0.24.0/grammar.js> .

<https://drift-king.org/rust/ast#StringLiteral>
    a owl:Class ;
    rdfs:label "string_literal" ;
    rdfs:isDefinedBy <https://github.com/tree-sitter/tree-sitter-rust/blob/v0.24.0/grammar.js> ;
    rdfs:comment "the-linter/rules/strings-rust-v2.yml's match: a string_literal, a whole concat! invocation, or a whole binary_expression joining two with +. A format! invocation is not one unit: each literal in it is its own, and so is each side of a comparison." .

<https://drift-king.org/rust/ast#StringLiteral.value>
    a owl:DatatypeProperty ;
    rdfs:domain <https://drift-king.org/rust/ast#StringLiteral> ;
    rdfs:label "StringLiteral.value" ;
    rdfs:comment "The literal's text, quotes stripped; for a joined pair, both pieces' values concatenated." .

<https://drift-king.org/rust/ast#StringLiteral.line>
    a owl:DatatypeProperty ;
    rdfs:domain <https://drift-king.org/rust/ast#StringLiteral> ;
    rdfs:label "StringLiteral.line" ;
    rdfs:comment "The line the literal, or the joining expression, starts on." .

<https://drift-king.org/javascript/ast#>
    a owl:NamedIndividual ;
    dcterms:title "tree-sitter-javascript grammar, as ast-grep records code in" ;
    vann:preferredNamespacePrefix "js" ;
    vann:preferredNamespaceUri "https://drift-king.org/javascript/ast#" ;
    rdfs:isDefinedBy <https://github.com/tree-sitter/tree-sitter-javascript/blob/v0.23.1/grammar.js> .

<https://drift-king.org/javascript/ast#String>
    a owl:Class ;
    rdfs:label "string" ;
    rdfs:isDefinedBy <https://github.com/tree-sitter/tree-sitter-javascript/blob/v0.23.1/grammar.js> ;
    rdfs:comment "the-linter/rules/strings-js-v2.yml's match: a string, a template_string, or a whole binary_expression joining two with +. Each side of a comparison is its own." .

<https://drift-king.org/javascript/ast#String.value>
    a owl:DatatypeProperty ;
    rdfs:domain <https://drift-king.org/javascript/ast#String> ;
    rdfs:label "String.value" ;
    rdfs:comment "The literal's text, quotes stripped; for a joined pair, both pieces' values concatenated." .

<https://drift-king.org/javascript/ast#String.line>
    a owl:DatatypeProperty ;
    rdfs:domain <https://drift-king.org/javascript/ast#String> ;
    rdfs:label "String.line" ;
    rdfs:comment "The line the literal, or the joining expression, starts on." .

<https://drift-king.org/the-linter/rules/strings-rust.yml>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    # Replaced, never edited: its bytes are on a signed approval page (#10).
    # It no longer references the language, so nothing reads with it.
    dcterms:isReplacedBy <https://drift-king.org/the-linter/rules/strings-rust-v2.yml> ;
    dcterms:subject <https://drift-king.org/rust/ast#StringLiteral> ;
    dcterms:conformsTo <https://yaml.org/spec/1.2.2/> ;
    rdfs:comment "An ast-grep rule. ast-grep's own rule-schema reference (not yet dug into this repo) would be the more exact conformsTo; YAML's own spec is what's verified so far." .

<https://drift-king.org/the-linter/rules/strings-js.yml>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    # Replaced, never edited: its bytes are on a signed approval page (#10).
    dcterms:isReplacedBy <https://drift-king.org/the-linter/rules/strings-js-v2.yml> ;
    dcterms:subject <https://drift-king.org/javascript/ast#String> ;
    dcterms:conformsTo <https://yaml.org/spec/1.2.2/> ;
    rdfs:comment "An ast-grep rule, same shape as strings-rust.yml, for tree-sitter-javascript's grammar." .

# The rules as they read today. v1 skipped every literal inside a binary
# expression, meaning to skip only the two sides of a join; a comparison such
# as a == "x" went unseen. v2 skips a literal only when it is one side of a
# join the first branch already caught as one unit.
<https://drift-king.org/the-linter/rules/strings-rust-v2.yml>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    prov:wasRevisionOf <https://drift-king.org/the-linter/rules/strings-rust.yml> ;
    dcterms:references <https://doc.rust-lang.org/reference/> ;
    dcterms:subject <https://drift-king.org/rust/ast#StringLiteral> ;
    dcterms:conformsTo <https://yaml.org/spec/1.2.2/> ;
    rdfs:comment "An ast-grep rule. ast-grep's own rule-schema reference (not yet dug into this repo) would be the more exact conformsTo; YAML's own spec is what's verified so far." .

<https://drift-king.org/the-linter/rules/strings-js-v2.yml>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    prov:wasRevisionOf <https://drift-king.org/the-linter/rules/strings-js.yml> ;
    dcterms:references <https://tc39.es/ecma262/> ;
    dcterms:subject <https://drift-king.org/javascript/ast#String> ;
    dcterms:conformsTo <https://yaml.org/spec/1.2.2/> ;
    rdfs:comment "An ast-grep rule, same shape as strings-rust-v2.yml, for tree-sitter-javascript's grammar." .

