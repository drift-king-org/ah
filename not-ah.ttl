    dcterms:identifier "sha256:25551bada8787ce72e0f1f66351ae858a55189a9f1c67d1a2943972cb0c125ac" ,
        # npm's integrity for the version, as the registry gives it.
        "sha512-O76sSZcof2rlnllQftA7pHNGB1M71OhleDRJGBJzVAiQeXcdysE/Qir6hvCDXCawBDY3V3yRzereBO0eSQ3xhw==" ;
    prov:wasDerivedFrom <https://registry.npmjs.org/@apricotter/x-components/-/x-components-0.1.0.tgz> .
