  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ;
  rdfs:comment "The target, not today's reality: see the open gap below. Kept as earl:passed (not earl:failed) so ah.ttl is never itself read as a failed-assertion subject -- that would make canary-isolation.rq treat the real model as its own canary." ] .

# The gap itself (M3.1) is modeled in ah.ttl, not here: it is a fact about
# the build's current state, not about the-linter's own machinery, and the
# reviewer's shape for it needs oa: (Web Annotation), which ah.ttl imports.

<https://drift-king.org/not-ah/agent/coder>
    a prov:SoftwareAgent ;
    rdfs:label "the coder" ;
    rdfs:comment "Writes gap nodes and model changes. Never the one who signs a gap -- that takes a real prov:Activity with a DocuSign dev envelope id (known-gap.rq)." .

