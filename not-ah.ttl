<https://drift-king.org/the-linter/canaries/plan-cycle.ttl>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> ;
    rdfs:comment "Two steps in their own fake plan, each isPrecededBy the other. the-builder's step-ordering must detect the cycle and stop." .

# ---------------------------------------------------------------------------
# M3: the plan, with the checks as steps. Two command steps (scan, string
# extraction) feed the query steps that read their output; every check is a
# canary step, then a real step preceded by it. Chained sequentially --
# isPrecededBy is transitive, but the-builder's own ordering only follows
# direct edges, so the chain has to be real, not just implied.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/scan>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/not-ah/the-linter/var/disk-scan> ;
    dcterms:title "scan the disk" ;
    sd:hasExecutionCommand "git ls-files -co --exclude-standard" .
<https://drift-king.org/not-ah/the-linter/var/disk-scan>
    a p-plan:Variable ; rdfs:label "disk-scan observations" .

<https://drift-king.org/not-ah/the-linter/extract-strings>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/source-code> ;
    p-plan:hasOutputVar <https://drift-king.org/not-ah/the-linter/var/extracted-strings> ;
    dcterms:title "extract strings with ast-grep" ;
    rdfs:comment "Reads every source folder that is one of its inputs, with that folder's rule (the-builder/queries/code-scope.rq). All the code we write is in scope, the-builder's own included. The command only checks ast-grep is there; the folders come from the model, never from main.rs." ;
    sd:hasExecutionCommand "ast-grep --version" ;
    dcterms:requires <https://drift-king.org/not-ah/ast-grep> .
<https://drift-king.org/not-ah/the-linter/var/extracted-strings>
    a p-plan:Variable ; rdfs:label "extracted string literals, as RDF" .
<https://drift-king.org/not-ah/the-linter/var/source-code>
    a p-plan:Variable ; rdfs:label "the source folders the string check reads" .

# The code we write, each folder with the rule that reads it (reviewer).
<https://drift-king.org/the-builder/src>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/source-code> ;
    dcterms:requires <https://drift-king.org/the-linter/rules/strings-rust-v2.yml> .
<https://drift-king.org/cloudflare-pid-rs/pid1/src>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/source-code> ;
    dcterms:requires <https://drift-king.org/the-linter/rules/strings-rust-v2.yml> .
<https://drift-king.org/cloudflare-pid-rs/worker/src>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/source-code> ;
    dcterms:requires <https://drift-king.org/the-linter/rules/strings-js-v2.yml> .

<https://drift-king.org/ah.ttl> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/the-model> .
<https://drift-king.org/not-ah/the-linter/var/the-model>
    a p-plan:Variable ; rdfs:label "the loaded model" .

<https://drift-king.org/the-linter/checks/named-by-nobody.rq> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/named-by-nobody-rq> .
<https://drift-king.org/not-ah/the-linter/var/named-by-nobody-rq> a p-plan:Variable .
<https://drift-king.org/the-linter/canaries/named-by-nobody.ttl> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/named-by-nobody-canary> .
<https://drift-king.org/not-ah/the-linter/var/named-by-nobody-canary> a p-plan:Variable .

<https://drift-king.org/not-ah/the-linter/named-by-nobody/canary-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/scan> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/named-by-nobody-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/named-by-nobody-canary> ;
    dcterms:title "named-by-nobody: canary must find something" .
<https://drift-king.org/not-ah/the-linter/named-by-nobody/real-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/named-by-nobody/canary-step> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/named-by-nobody-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/the-model> ,
