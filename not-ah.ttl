# ---------------------------------------------------------------------------
# Vendored vocabularies (M1). Oxigraph doesn't follow owl:imports, so a
# check that needs a vocabulary's own rdfs:domain/range statements (the
# ones domain-retypes and range-retypes actually run against) has to read
# a local copy. Fetched once, named here with the sha256 of the exact bytes
# on disk, and mapped in catalog-v001.xml by each vocabulary's own
# self-declared name -- not the URL it happened to be fetched from. No
# network at build time from here on: the-builder reads only vocab/.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/vocab/dcat>
    a dcat:Dataset ;
    dcterms:title "DCAT" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/dcat3.ttl> .
<https://drift-king.org/the-builder/vocab/dcat3.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://www.w3.org/ns/dcat3.ttl"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:d1624d3bbf364f6fc1d43b9a188bbb9e67639b1a7d46a5cb7ea3f5d47d02b62f" .

<https://drift-king.org/not-ah/vocab/dcmi-terms>
    a dcat:Dataset ;
    dcterms:title "DCMI Terms" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/dublin_core_terms.ttl> .
<https://drift-king.org/the-builder/vocab/dublin_core_terms.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://www.dublincore.org/specifications/dublin-core/dcmi-terms/dublin_core_terms.ttl"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:13df401072dd7015bf9d75162f3e41c8138075304b7b9cc1aa1e9c16db976797" ;
    rdfs:comment "purl.org/dc/terms/'s own redirect chain terminates at purl.archive.org, which was down (real 503, confirmed twice) -- fetched from DCMI's own direct hosting instead, same bytes." .

<https://drift-king.org/not-ah/vocab/prov-o>
    a dcat:Dataset ;
    dcterms:title "PROV-O" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/prov-o.ttl> .
<https://drift-king.org/the-builder/vocab/prov-o.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://www.w3.org/ns/prov-o#"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:7d203989f67b38bca572253942acc5a1bf24ce3ccfece16f072dcb4be2b79a96" .

<https://drift-king.org/not-ah/vocab/sd>
    a dcat:Dataset ;
    dcterms:title "SD" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/sd.ttl> .
<https://drift-king.org/the-builder/vocab/sd.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://w3id.org/okn/o/sd"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:c44942dce9260d53a25e42adf73e3c04f9f58d8dcd20d2957b02af105c589fef" .

<https://drift-king.org/not-ah/vocab/sosa>
    a dcat:Dataset ;
    dcterms:title "SOSA" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/sosa.ttl> .
<https://drift-king.org/the-builder/vocab/sosa.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://www.w3.org/ns/sosa/"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:c70b0d1c843c0047e4c98e0a89392e46a05752ff6365bda7f7f55303905a0392" .

<https://drift-king.org/not-ah/vocab/shacl>
    a dcat:Dataset ;
    dcterms:title "SHACL" ;
    rdfs:comment "The Shapes Constraint Language, for closing the model off: what a contract, a signing or any other record must hold. Also what @apricotter/x-components' component.ttl imports, by the name without its #." ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/shacl.ttl> .
<https://drift-king.org/the-builder/vocab/shacl.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://www.w3.org/ns/shacl.ttl"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:0e5d8aea0eab98a072d4a02faaee1ee914ec99eab2ca473429726faed4a13f69" .

<https://drift-king.org/not-ah/vocab/vann>
    a dcat:Dataset ;
    dcterms:title "VANN" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/vann.rdf> .
<https://drift-king.org/the-builder/vocab/vann.rdf>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "https://vocab.org/vann/vann-vocab-20100607.rdf"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    dcterms:identifier "sha256:cd314dbeebfd4fe1840fdddfc3873b4e813a06d8fae80b1e442e2bb918ef3dd8" ;
    rdfs:comment "purl.org/vocab/vann/ redirects to vocab.org/vann/, whose default representation is HTML (ignores Accept: text/turtle); vann-vocab-20100607.rdf is the real vocabulary, fetched with Accept: application/rdf+xml." .

<https://drift-king.org/not-ah/vocab/skos>
    a dcat:Dataset ;
    dcterms:title "SKOS" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/skos.rdf> .
<https://drift-king.org/the-builder/vocab/skos.rdf>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://www.w3.org/2004/02/skos/core"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    dcterms:identifier "sha256:e79633b8d0564816cee8a99f5c9acf9a0e6fc7257c7209acd684ecad53a89dd6" ;
    rdfs:comment "Not one of M1's nine -- found by actually running the-builder against the catalog: DCAT's own owl:imports needs it. Accept: text/turtle got RDF/XML anyway; Accept: application/rdf+xml is honest about what it serves." .

<https://drift-king.org/not-ah/vocab/earl>
    a dcat:Dataset ;
    dcterms:title "EARL" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/earl.rdf> .
<https://drift-king.org/the-builder/vocab/earl.rdf>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://www.w3.org/ns/earl#"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    dcterms:identifier "sha256:4cde74807d5e31e58cc462ea6c1b1fc8fc0cf5bdbf8ac224ef95525efbeb2879" ;
    rdfs:comment "Accept: text/turtle got 406 Not Acceptable at this URL; application/rdf+xml is what it actually serves." .

<https://drift-king.org/not-ah/vocab/oa>
    a dcat:Dataset ;
    dcterms:title "Web Annotation" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/oa.ttl> .
<https://drift-king.org/the-builder/vocab/oa.ttl>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://www.w3.org/ns/oa#"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:identifier "sha256:f661e37d33bf29176390101687711734a7e33a716bdecfb66b90c732373d7af5" .

<https://drift-king.org/not-ah/vocab/p-plan>
    a dcat:Dataset ;
    dcterms:title "P-Plan" ;
    dcat:distribution <https://drift-king.org/the-builder/vocab/p-plan.rdf> .
<https://drift-king.org/the-builder/vocab/p-plan.rdf>
    a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcat:downloadURL "http://purl.org/net/p-plan#"^^xsd:anyURI ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    dcterms:identifier "sha256:b426b2b8471f41a337256d3248fc0f595be8bc83e3969ac27c1dc51f689c5b32" ;
    rdfs:comment "Accept: text/turtle got 406 Not Acceptable at this URL; application/rdf+xml is what it actually serves. Corrected: this file declares isPrecededBy, the normal spelling -- an earlier note here claiming isPreceededBy (double e) was wrong, copied from a summarised web page rather than checked against this vendored file. The vendored copy is the authority over any doc, this one included." .

# What not-ah lists, ah never lists. The inverse is stated in ah.ttl.
[ a owl:Restriction ;
  owl:onProperty [ owl:inverseOf dcat:resource ] ;
  owl:hasValue <https://drift-king.org/not-ah> ]
  owl:disjointWith
[ a owl:Restriction ;
  owl:onProperty [ owl:inverseOf dcat:resource ] ;
  owl:hasValue <https://drift-king.org/ah> ] .

# DCMI declares requires only as rdf:Property, so OWL cannot tell it links
# two things and Protégé files it as an annotation. This names it a relation.
# A statement about DCMI's term, not ours: the one foreign subject here.
dcterms:requires a owl:ObjectProperty .

# ---------------------------------------------------------------------------
# canary-isolation (added by the reviewer, 2026-09-28): no step may read a
# canary and the model together. A linter check, not a builder rule, so the
# plan itself is what gets checked. First in the check chain: the chain's
# first canary step is preceded by its real step, so every build step is too.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-linter/checks/canary-isolation.rq>
    a dcat:Resource , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "no step reads a canary and the model together" .

# Must be caught: a step reading a canary and ah.ttl. Must stay clean: a step
# reading the canary alone. Its own fake plan.
<https://drift-king.org/the-linter/canaries/canary-isolation.ttl>
    a p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> .

[ a earl:Assertion ;
  earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/the-linter/canaries/canary-isolation.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/canary-isolation.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ] .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/ah.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/canary-isolation.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ] .

<https://drift-king.org/the-linter/checks/canary-isolation.rq> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/canary-isolation-rq> .
<https://drift-king.org/not-ah/the-linter/var/canary-isolation-rq> a p-plan:Variable .
<https://drift-king.org/the-linter/canaries/canary-isolation.ttl> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/canary-isolation-canary> .
<https://drift-king.org/not-ah/the-linter/var/canary-isolation-canary> a p-plan:Variable .

<https://drift-king.org/not-ah/the-linter/canary-isolation/canary-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/canary-isolation-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/canary-isolation-canary> ;
    dcterms:title "canary-isolation: canary must find something" .
<https://drift-king.org/not-ah/the-linter/canary-isolation/real-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/canary-isolation/canary-step> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/canary-isolation-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/the-model> ;
    dcterms:title "canary-isolation: the real model must pass" .

# Put it first: the chain's first check now waits for this one.
<https://drift-king.org/not-ah/the-linter/named-by-nobody/canary-step>
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/canary-isolation/real-step> .
# Asserted, not inferred: correspondsToVariable's domain is p-plan:Entity.
<https://drift-king.org/the-linter/checks/canary-isolation.rq> a p-plan:Entity .

# ---------------------------------------------------------------------------
# iri-names-not-values (added by the reviewer, 2026-09-28): an IRI in our
# namespace is a name and must not carry a value such as a digest. Runs early
# in the check chain, next to canary-isolation.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-linter/checks/iri-names-not-values.rq>
    a dcat:Resource , p-plan:Entity , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "an IRI names a thing; it never carries a value" .

# Must be caught: an image IRI with its sha256 in the path. Must stay clean:
# the same image under a stable name, with the digest as data.
<https://drift-king.org/the-linter/canaries/iri-names-not-values.ttl>
    a p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> .

[ a earl:Assertion ;
  earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/the-linter/canaries/iri-names-not-values.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/iri-names-not-values.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ] .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/ah.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/iri-names-not-values.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ] .

<https://drift-king.org/the-linter/checks/iri-names-not-values.rq> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-rq> .
<https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-rq> a p-plan:Variable .
<https://drift-king.org/the-linter/canaries/iri-names-not-values.ttl> p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-canary> .
<https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-canary> a p-plan:Variable .

<https://drift-king.org/not-ah/the-linter/iri-names-not-values/canary-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-canary> ;
    dcterms:title "iri-names-not-values: canary must find something" .
<https://drift-king.org/not-ah/the-linter/iri-names-not-values/real-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/iri-names-not-values/canary-step> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/var/iri-names-not-values-rq> ,
        <https://drift-king.org/not-ah/the-linter/var/the-model> ;
    dcterms:title "iri-names-not-values: the real model must pass" .

# ---------------------------------------------------------------------------
# approvals-are-documents (added by the reviewer, M3.8): every file in
# approvals/ is a CommonMark document the model names. Runs between
# iri-names-not-values and named-by-nobody; its real step reads the disk scan.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-linter/checks/approvals-are-documents.rq>
    a dcat:Resource , p-plan:Entity , earl:TestCriterion , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    dcterms:title "every file in approvals/ is a CommonMark document the model names" .

# Must be caught: an unnamed file and a plain-text file in approvals/. Must
# stay clean: a CommonMark document there, and a file outside the folder.
<https://drift-king.org/the-linter/canaries/approvals-are-documents.ttl>
    a p-plan:Entity , earl:TestSubject , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> .

[ a earl:Assertion ;
