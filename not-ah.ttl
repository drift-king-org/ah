# ---------------------------------------------------------------------------
# @apricotter/x-components: Apricotter's components, which drift-king.org is
# to be written in. Someone else's software, so it is listed here, like
# @cloudflare/containers. Not published yet: when 0.1.0 is, its tarball's
# sha256 and npm's integrity are added here, and the tarball is kept in the
# repo so no build fetches it.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/npm/apricotter-x-components>
    a sd:SoftwareVersion ;
    sd:name "@apricotter/x-components" ;
    sd:hasVersionId "0.1.0" ;
    sd:hasDownloadURL "https://registry.npmjs.org/@apricotter/x-components/-/x-components-0.1.0.tgz"^^xsd:anyURI ;
    dcterms:source <https://github.com/Apricotter/x-components> ;
    dcterms:conformsTo <https://drift-king.org/intent/x-components-letter-of-intent.md> ;
    rdfs:comment "What it promises is its signed letter of intent and list. Drift King audits the tarball against both before taking it." .

# Its model, which ah will import once the tarball is kept here: the catalog
# then maps each name to the file unpacked from it.
<https://drift-king.org/not-ah/vocab/x-components>
    a dcat:Dataset ;
    dcterms:title "the x-components component model" ;
    rdfs:comment "component.ttl, and the wai-aria.ttl it imports, as shipped in @apricotter/x-components 0.1.0. Every x-* tag drift-king.org uses must be one of its components." ;
    dcterms:isPartOf <https://drift-king.org/not-ah/npm/apricotter-x-components> .

# ===========================================================================
# @apricotter/x-components 0.1.0, the candidate: the files its tarball will
# hold, kept here exactly as committed at b1a6b38 on its public repository,
# before it is published. Drift King audits these bytes with its own checks.
# Kept as files, not as a tarball: npm's version changes a tarball's bytes,
# never its files'. When 0.1.0 is published, its tarball's files are checked
# against these, file by file, before Drift King takes it.
