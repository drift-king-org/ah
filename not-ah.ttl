# ---------------------------------------------------------------------------
# The two questions the-builder asks the model directly (M3): what a plan's
# steps are, and which precedes which. Named here so main.rs holds no SPARQL
# of its own -- the same discipline as the-linter's checks, applied to the
# builder's own mechanics.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-builder/queries/subject-rule.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "the ast-grep rule and string class for a source file, from its language" .

<https://drift-king.org/the-builder/queries/plan-steps.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "a plan's steps, with each one's title and command" .

<https://drift-king.org/the-builder/queries/step-precedes.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "the isPrecededBy edges among a plan's steps" .

<https://drift-king.org/the-builder/queries/step-input-entities.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "a step's input entities, by way of its Variables" .

<https://drift-king.org/the-builder/queries/expected-outcome.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "the EARL outcome already asserted for a (test, subject) pair" .

<https://drift-king.org/the-builder/queries/code-scope.rq>
    a dcat:Resource , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    dcterms:title "which source folders the string check reads, and with which rule" .

<https://drift-king.org/the-builder/queries/publish-copies.rq>
    a dcat:Resource , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    dcterms:title "what a copy step publishes: source, target and sha256 for each output copy" .

<https://drift-king.org/the-builder/queries/known-gap.rq>
    a dcat:Resource ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "whether a (test, subject) pair has a signed, open gap -- a prov:Activity actually signed it, not merely a node claiming one" .

<https://drift-king.org/the-linter/canaries/known-gap-unsigned.ttl>
    a earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> ;
    rdfs:comment "Canary for known-gap.rq (M3.1): a gap node shaped exactly like a real one, with no signing prov:Activity. known-gap.rq must find nothing for it -- an unsigned gap must not excuse a failure." .

# file-provenance (added by the reviewer, 2026-09-28): named so
# named-by-nobody passes. Wiring it as a check (plan steps, EARL
# assertions, canary/real chain) is the reviewer's own next milestone,
# after M3 is committed -- not done here.
<https://drift-king.org/the-linter/checks/file-provenance.rq>
    a dcat:Resource , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> .
<https://drift-king.org/the-linter/canaries/file-provenance.ttl>
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> .

