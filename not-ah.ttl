# ===========================================================================
# The repository is clean: every tracked file, every file the site publishes, and every
# commit message and author passes the named rules below. A rule is either a format (a local
# path, an account ID's shape, a key or token's shape, a private host) or the private values
# themselves, which are not written here: they are read at run time from one file outside the
# repository, named by a setting, and the model holds only the setting's name and the file's
# sha256. Nothing that names a private value, or looks like a secret, is written down in order
# to look for it: each canary is built when the check runs, in a scratch folder, and removed.
# ===========================================================================
<https://drift-king.org/not-ah/the-linter/clean-rules> a prov:Collection ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:title "the clean rules" ;
    rdfs:comment "What may not appear in anything Drift King publishes: local paths, personal addresses, account IDs, keys and tokens, private hosts, and the private values. Role addresses at drift-king.org are allowed." .
<https://drift-king.org/not-ah/setting/private-values> a prov:Entity ;
    rdfs:label "DRIFT_KING_PRIVATE_VALUES" ;
    rdfs:comment "The path of the file that holds the private values (names, a personal subdomain, anything personal), one to a line. Read from the environment by name. If it is missing, or the file is not the one the model holds the sha256 of, the clean check cannot run: it exits 2, never a pass." .
<https://drift-king.org/not-ah/private/private-values> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:836a898ed1947619c5603c8605c3b28cc4dc7683eaa138ac906afd9aefcf06f8" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "the private values" ;
    rdfs:comment "The file of values nothing published may hold. Kept beside the moved evidence on the lead architect's machine; named and hashed here and never published." .
<https://drift-king.org/not-ah/the-linter/clean/personal-values> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "personal-values" ;
    dcterms:title "no private value: a name or a personal subdomain, read at run time from the file the setting names" ;
    dcterms:requires <https://drift-king.org/not-ah/setting/private-values> ;
    dcterms:source <https://drift-king.org/not-ah/private/private-values> .
<https://drift-king.org/not-ah/the-linter/clean/local-path> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "local-path" ;
    dcterms:title "no local path" ;
    sh:pattern "[C]:[\\\\/]+[U]sers|/[U]sers/|/[h]ome/" ;
    skos:example "C:||\\Users\\||someone\\project" .
<https://drift-king.org/not-ah/the-linter/clean/personal-email> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "personal-email" ;
    dcterms:title "no personal email address: role addresses at drift-king.org are allowed, and so are the W3C's public lists" ;
    sh:pattern "[A-Za-z0-9._%+-]+@(?!(drift-king|w3)\\.org\\b)[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}" ;
    skos:example "someone.personal||@||example.com" .
<https://drift-king.org/not-ah/the-linter/clean/account-id> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "account-id" ;
    dcterms:title "no account ID: a Cloudflare account ID is 32 hexadecimal digits" ;
    sh:pattern "(?<![0-9a-f])[0-9a-f]{32}(?![0-9a-f])" ;
    skos:example "0123456789abcdef||0123456789abcdef" .
<https://drift-king.org/not-ah/the-linter/clean/secret-key-block> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "secret-key-block" ;
    dcterms:title "no private key block" ;
    sh:pattern "-----BEGIN [A-Z ]*PRIVATE KEY" ;
    skos:example "-----BEGIN RSA PRIV||ATE KEY-----" .
<https://drift-king.org/not-ah/the-linter/clean/secret-token> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "secret-token" ;
    dcterms:title "no token of a known kind" ;
    sh:pattern "\\bghp_[A-Za-z0-9]{20,}|\\bcfut_[A-Za-z0-9]{10,}|\\bAKIA[0-9A-Z]{16}\\b|\\bsk-[A-Za-z0-9]{20,}" ;
    skos:example "gh||p_abcdefghijklmnopqrstuvwxyz0123456789" .
<https://drift-king.org/not-ah/the-linter/clean/secret-assignment> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "secret-assignment" ;
    dcterms:title "no secret, key, token or password given a value" ;
    sh:pattern "(api[_-]?key|secret|token|password)[\"\\']?\\s*[:=]\\s*[\"\\'][^\"\\'\\s]{12,}[\"\\']" ;
    skos:example "pass||word = \"not-a-real-password-value\"" .
<https://drift-king.org/not-ah/the-linter/clean/private-host> a earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter/clean-rules> ;
    skos:prefLabel "private-host" ;
    dcterms:title "no private host, and no workers.dev host: a personal subdomain is one" ;
    sh:pattern "[p]rivate\\.drift-king\\.org|\\.workers\\.dev\\b" ;
    skos:example "see the-name.example-subdomain.work||ers.dev for it" .
<https://drift-king.org/the-linter/checks/clean.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "Reads the rules the model names and scans every tracked file, every published file and every commit message and author. With --canaries it builds each rule's canary in a scratch folder, scans it, removes it, and exits 1 only if every one was found." .

# ===========================================================================
# What Drift King keeps and does not publish. Each is named, hashed and attributed here, held
# on the lead architect's machine outside this repository, and never published. The address of
# each says so, instead of breaking: see the page it is sent to. Evidence is never edited.
# ===========================================================================
<https://drift-king.org/not-ah/PrivateItem> a owl:Class ;
    rdfs:label "private item" ;
    rdfs:comment "Something Drift King keeps and does not publish." .
<https://drift-king.org/cloudflare-pid-rs/proof/M3-push.txt> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:0de7eb27e37a212efa875652bf19ba450109455a10205193975372f146f9417d" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "M3-push.txt" ;
    rdfs:comment "Evidence: the push, the digest, the image config, and the known leftover. It holds an account ID, a personal workers.dev subdomain or a name, so it is kept on the lead architect's machine, named and hashed here, and never published. Not edited." .
<https://drift-king.org/cloudflare-pid-rs/proof/M4-deploy.txt> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:ccc56c8c6e8de2eab45e808a48ed00afbe4bb49f2eb079f1a1454fd988fdaeb6" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "M4-deploy.txt" ;
    rdfs:comment "Evidence: the wrangler deploy output. It holds an account ID, a personal workers.dev subdomain or a name, so it is kept on the lead architect's machine, named and hashed here, and never published. Not edited." .
<https://drift-king.org/cloudflare-pid-rs/proof/M7-custom-domain.txt> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:4654914af741b5776f86ec294b153d0d9afc9d4f439e5ca4cb7add2819d08612" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "M7-custom-domain.txt" ;
    rdfs:comment "Evidence: the move from workers.dev to pid1.drift-king.org. It holds an account ID, a personal workers.dev subdomain or a name, so it is kept on the lead architect's machine, named and hashed here, and never published. Not edited." .
<https://drift-king.org/the-builder/proof/B2-dry-run.txt> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:056ecb5cf46732191f47ff5081cb65eb8105e32b1be65c567d2dd0e8b66ec80f" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "B2-dry-run.txt" ;
    rdfs:comment "Evidence: --dry-run's printed step order, lint first and deploy last, read from the requires graph. It holds an account ID, a personal workers.dev subdomain or a name, so it is kept on the lead architect's machine, named and hashed here, and never published. Not edited." .
<https://drift-king.org/not-ah/private/docusign-approval-skill-as-signed> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "sha256:bd1f491b6c698ffd0897c752ac607eb886acb69fddd34611dec6db743708694f" ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    rdfs:label "docusign-approval-skill-as-signed" ;
    rdfs:comment "The skill file exactly as the signing-plan-v2 packet names it. It points at a folder on the lead architect's machine, so those bytes are kept there, named and hashed here, and never published. The skill in the repository is its successor with that path taken out: a new file, to be signed." ;
    dcterms:isReplacedBy <https://drift-king.org/.claude/skills/docusign-approval/SKILL.md> .

# Where the source is public. The repository's address is one fact, here; the redirects are
# written from it.
<https://drift-king.org/not-ah/repository> a dcat:Resource ;
    dcterms:title "the drift-king repository on GitHub" ;
    dcterms:source <https://github.com/drift-king-org/ah> ;
    rdfs:comment "Where the source of Drift King is public. The lead architect named it: the repository ah, in the organization drift-king-org. It is one node to change." .

# Private history. Drift King's public repository starts from one root commit of the clean tree. The
# commits before it stay on the lead architect's machine, on a branch that is never pushed. Each old
# commit the model or its evidence names is listed here, so its address says that it is private
# history rather than breaking.
<https://drift-king.org/not-ah/private-history/m3-the-plan-is-p-plan> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "git:commit:f9a785550c584ac7973b19a35f12ba8fdee4591a" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "M3: the plan is P-Plan, checks run for real, no SPARQL in main.rs" ;
    rdfs:comment "A commit of the history before the public repository. Private history: ah/signings.ttl names it as the version of ah.ttl that had a finding." .
<https://drift-king.org/not-ah/private-history/initial-commit> a prov:Entity , <https://drift-king.org/not-ah/PrivateItem> ;
    dcterms:identifier "git:commit:fb106fd6c3f0544c5f5c2a6caf6419cb9025d779" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:label "Initial commit: cloudflare-pid-rs PID1 proof, the-builder scaffold, model" ;
    rdfs:comment "A commit of the history before the public repository. Private history: the-builder/proof/H0-first-commit.txt and H1-byte-exact.txt name it." .

# No ship follows a step that is local only.
<https://drift-king.org/the-linter/checks/local-only-not-shipped.rq>
    a dcat:Resource , p-plan:Entity , earl:TestCriterion ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    dcterms:title "no step that ships comes after a step that is local only" ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/rq> .
<https://drift-king.org/the-linter/canaries/local-only-not-shipped.ttl>
    a p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> ;
    vann:preferredNamespaceUri "https://drift-king.org/not-ah/canary/local-only-not-shipped/" ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/canary> .
<https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/rq> a p-plan:Variable .
<https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/canary> a p-plan:Variable .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/the-linter/canaries/local-only-not-shipped.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/local-only-not-shipped.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ] .
[ a earl:Assertion ; earl:assertedBy <https://drift-king.org/not-ah/the-linter> ;
  earl:subject <https://drift-king.org/ah.ttl> ;
  earl:test <https://drift-king.org/the-linter/checks/local-only-not-shipped.rq> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ] ] .
<https://drift-king.org/not-ah/the-linter/local-only-not-shipped/canary-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/ship-steps-marked/real-step> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/rq> , <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/canary> ;
    dcterms:title "no ship follows a local-only step: a ship plan that includes one must be caught" .
<https://drift-king.org/not-ah/the-linter/local-only-not-shipped/real-step>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/canary-step> ;
    p-plan:hasInputVar <https://drift-king.org/not-ah/the-linter/local-only-not-shipped/var/rq> , <https://drift-king.org/not-ah/the-linter/var/the-model> ;
    dcterms:title "no ship follows a local-only step: the model must pass" .
