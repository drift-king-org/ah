# What the pages needed that 0.1.0 had no component for. Each was asked of
# x-components' next version, generic, with no Drift King words in it, and 0.2.0
# has a component that meets it, named on the need.
<https://drift-king.org/ah/site/needs/ticker>
    a prov:Entity ; dcterms:title "a scrolling ticker of short phrases" ;
    dcterms:references <https://apricotter.com/ns/components#x-tape-pair> , <https://apricotter.com/ns/components#x-tape> , <https://apricotter.com/ns/components#x-tape-item> ;
    rdfs:comment "The two bands under the home page's hero." .
<https://drift-king.org/ah/site/needs/spot-the-drift>
    a prov:Entity ; dcterms:title "two numbered line panes side by side, one line marked, with a stamp" ;
    dcterms:references <https://apricotter.com/ns/components#x-line-panes> , <https://apricotter.com/ns/components#x-line-pane> , <https://apricotter.com/ns/components#x-line> ;
    rdfs:comment "The home page's intent-versus-code example." .
<https://drift-king.org/ah/site/needs/sticker>
    a prov:Entity ; dcterms:title "a rotated sticker label over a hero image" ;
    dcterms:references <https://apricotter.com/ns/components#x-sticker> ;
    rdfs:comment "The three labels on the home page's hero." .
<https://drift-king.org/ah/site/needs/seal>
    a prov:Entity ; dcterms:title "a round seal beside a block of text" ;
    dcterms:references <https://apricotter.com/ns/components#x-seal> ;
    rdfs:comment "The signed-and-hashed seal beside the letter on the home page." .

