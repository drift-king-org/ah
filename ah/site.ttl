# After the deploy, the live site is held to the same checks the local one is: every folder answers
# a missing address with the HTML 404, every published file is served with the type the model names,
# and every source address is sent by a 303 to GitHub at the commit the site was built from. A failure
# here is a failed ship. It runs only when the deploy does. Its canary, the same script against a small
# site that carries the old wildcard rule, is run in the local plan (ah/site/local/check-served).
<https://drift-king.org/ah/site/check-served-live>
    a <https://drift-king.org/ah/the-builder/ShipStep> , sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/deploy> ;
    dcterms:references <https://drift-king.org/ah/site/local/check-served> ;
    dcterms:title "check drift-king.org itself: the HTML 404 for every missing address, each file served with its model type, each source address a 303 to GitHub at the built commit" ;
    sd:hasExecutionCommand "node site/checks/check-served.mjs https://drift-king.org site/served.tsv site/source.tsv" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .

# The designer's design for the console, as received: one zip (the Intents screen, Intents in every
# state, and Watch a build), and the zip is the artifact. Copied, not moved, from the folder the lead
# architect keeps the designer's files in. The time is the file's own timestamp as it landed on disk.
<https://drift-king.org/design/drift-king-console-design.zip>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:identifier "sha256:544bf7af26b84fdf0a49b49897796ea9c30bd01bb77e43b54a32e21b0bf107d1" ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/designer> ;
    prov:generatedAtTime "2026-10-02T00:25:52Z"^^xsd:dateTime ;
    rdfs:label "The Drift King console design" .
<https://drift-king.org/site/public/approvals/drift-king-console-design.md> dcterms:format <https://www.iana.org/assignments/media-types/text/markdown> ;
    <https://drift-king.org/ah/site/servedUnaided> true ;
    <https://drift-king.org/ah/site/cacheControl> "no-transform" .
<https://drift-king.org/site/public/approvals/drift-king-console-design.html> dcterms:format <https://www.iana.org/assignments/media-types/text/html> ;
    <https://drift-king.org/ah/site/servedUnaided> true .
<https://drift-king.org/site/public/approvals/drift-king-console-design-approval.html> dcterms:format <https://www.iana.org/assignments/media-types/text/html> ;
    <https://drift-king.org/ah/site/servedUnaided> true .
<https://drift-king.org/site/public/design/drift-king-console-design.zip> dcterms:format <https://www.iana.org/assignments/media-types/application/zip> ;
    <https://drift-king.org/ah/site/servedUnaided> true .

# ===========================================================================
# The console's first screen, Intents, as a query over ah. intents.rq returns one row for each agreement
# (the document, the selector of what it asks for, what fulfils it, open or done as a boolean) and for each
# open gap (with the selector of the sentence of the letter it answers). The check builds its canaries when
# it runs: each is a graph the query must read right, and each must catch a query that reads it wrong, first.
# ===========================================================================
<https://drift-king.org/not-ah/queries/intents.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "the console's Intents: every agreement, what it asks for and what fulfils it, open or done, and every open gap" ;
    skos:notation "rows" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/console-intents> .
<https://drift-king.org/ah/site/var/console-intents> a p-plan:Variable ; rdfs:label "the console's Intents rows" .
<https://drift-king.org/the-linter/checks/intents.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "Builds four small graphs when it runs and runs the console's query on them: an agreement with nothing that fulfils it, an agreement whose check failed, a gap a signing invalidated, and one whose check passes. With --canaries it runs a broken query on each first." .
<https://drift-king.org/ah/site/check-intents>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    dcterms:title "the console's query works status out: an unfulfilled agreement is open, a failed check leaves it open, an invalidated gap is closed, and its open gaps are the gaps known-gap.rq returns, canary first" ;
    sd:hasExecutionCommand "node the-linter/checks/intents.mjs --canaries the-builder/target/release/the-builder.exe catalog-v001.xml not-ah/queries/intents.rq the-builder/queries/known-gap.rq; test $? -eq 1 || exit 1; node the-linter/checks/intents.mjs the-builder/target/release/the-builder.exe catalog-v001.xml not-ah/queries/intents.rq the-builder/queries/known-gap.rq" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .

# A step that is local only builds something to try on this machine, and nothing that ships may come after
# one. The ship plan must not include it: a check fails any ship that follows a local-only step.
<https://drift-king.org/ah/LocalOnlyStep> a owl:Class ;
    rdfs:label "local-only step" ;
    rdfs:comment "A step that makes something to try on this machine. No step that ships comes after it." .

# ===========================================================================
# The console, locally: Intents. A page made of x-components 0.2.0 and the rows of the Intents query, tried on this
# machine and nowhere else. Its steps are local only, so a ship plan that includes one is caught. The page is
# served from site/local/public on its own port by wrangler 4.145.0 (pinned); nothing here is written under
# site/public, and the /console links on the landing page stay closed.
# The design parts the page leaves out for want of a component are listed in the report of this change: no
# part of the design's HTML is copied, and none is written by hand.
# ===========================================================================
<https://drift-king.org/ah/site/page/console>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:title "the console's Intents page, in x-components" ;
    dcterms:requires <https://apricotter.com/ns/components#x-header> ,
        <https://apricotter.com/ns/components#x-console> ,
        <https://apricotter.com/ns/components#x-side-nav> ,
        <https://apricotter.com/ns/components#x-side-nav-item> ,
        <https://apricotter.com/ns/components#x-section> ,
        <https://apricotter.com/ns/components#x-page-heading> ,
