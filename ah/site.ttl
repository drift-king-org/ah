<https://drift-king.org/ah/site/render-intents>
    a <https://drift-king.org/ah/the-builder/RenderStep> , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/intents-template> ,
        <https://drift-king.org/ah/site/var/intents-content> ,
        <https://drift-king.org/ah/site/var/console-intents> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/intents-markup> ;
    dcterms:title "render the console's Intents page as x-* markup, from its template, its words and the Intents query (local only)" .
<https://drift-king.org/ah/site/expand-console>
    a sd:SoftwareConfiguration , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/render-intents> ,
        <https://drift-king.org/ah/site/render-home-settings> ,
        <https://drift-king.org/ah/site/x-components/install-expander> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/intents-html> ;
    dcterms:title "expand the console page to plain HTML, in site/local/public, never in site/public (local only)" ;
    sd:hasExecutionCommand "cd site/expander && node expand-home.mjs markup/console.html settings.json ../local/public/console/index.html" ;
    dcterms:requires <https://drift-king.org/not-ah/node> , <https://drift-king.org/not-ah/npm/cheerio/1.2.0> .
<https://drift-king.org/ah/site/local-copy>
    a <https://drift-king.org/ah/the-builder/CopyStep> , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/local-copies> ;
    dcterms:title "copy the console's styles and fonts into site/local/public, from the commit (local only)" .
<https://drift-king.org/ah/site/serve-local-console>
    a sd:SoftwareConfiguration ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:title "serve the console's local folder on this machine" ;
    sd:hasExecutionCommand "cd site/local && npx --yes wrangler@4.145.0 dev --local --port 8789" ;
    dcterms:requires <https://drift-king.org/not-ah/wrangler> ;
    rdfs:comment "Port 8789. Started and stopped by its PIDs, like serve-local, and never part of a ship." .
<https://drift-king.org/ah/site/endpoint/local-console>
    a dcat:DataService ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcat:endpointURL <http://127.0.0.1:8789/console/> ;
    rdfs:comment "The console's Intents page on the lead architect's machine. Never public." .
<https://drift-king.org/ah/site/check-console-tags>
    a sd:SoftwareConfiguration , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/publish> ;
    dcterms:title "every tag on the console page is a component the model defines, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-tags.mjs site/checks/canaries/undefined-tag.mustache site/expander/x-components/component.ttl site/expander/x-components/component-attributes.generated.mjs; test $? -eq 1 || exit 1; node site/checks/check-tags.mjs site/templates/console.mustache site/expander/x-components/component.ttl site/expander/x-components/component-attributes.generated.mjs" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/check-console-only-components>
    a sd:SoftwareConfiguration , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    dcterms:title "the console page is made of components and nothing else, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-only-components.mjs site/checks/canaries/plain-div.mustache; test $? -eq 1 || exit 1; node site/checks/check-only-components.mjs site/templates/console.mustache" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/check-console-styles>
    a sd:SoftwareConfiguration , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/publish> ;
    dcterms:title "the console page styles only classes the pinned version emits, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-styles.mjs site/checks/canaries/styles.css site/expander/x-components/component-attributes.generated.mjs; test $? -eq 1 || exit 1; node site/checks/check-styles.mjs site/console.css site/expander/x-components/component-attributes.generated.mjs" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/check-console-expanded>
    a sd:SoftwareConfiguration , <https://drift-king.org/ah/LocalOnlyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/expand-console> ;
    dcterms:title "no tag is left unexpanded on the console page, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-expanded.mjs site/checks/canaries/unexpanded.html; test $? -eq 1 || exit 1; node site/checks/check-expanded.mjs site/local/public/console/index.html" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
