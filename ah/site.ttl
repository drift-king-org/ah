# On this machine only: serve the site, try the page in a real browser, stop the
# server by its PID. Not a step of the-builder: the server runs until it is
# stopped. These change nothing outside this machine.
<https://drift-king.org/ah/site/local/plan>
    a p-plan:Plan ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:title "try the home page in a real browser at 127.0.0.1:8787" ;
    dcterms:description "Start serve-local, run the tape checks and the link check against http://127.0.0.1:8787/ in Chromium, each with its canary first, stop serve-local by the PIDs it started, and confirm the port is free." .
<https://drift-king.org/ah/site/local/check-tape>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/local/plan> ;
    dcterms:references <https://drift-king.org/ah/site/endpoint/local> ;
    dcterms:title "the tape: the space bar pauses and plays both bands, the glyph says which, reduced motion stops them, a focused link pauses them" ;
    sd:hasExecutionCommand "node site/checks/check-tape.mjs http://127.0.0.1:8787/ ../apricotter/apricotter-microsites/node_modules/playwright" ;
    dcterms:requires <https://drift-king.org/not-ah/node> , <https://drift-king.org/not-ah/npm/playwright/1.61.1> .
<https://drift-king.org/ah/site/local/check-links>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/local/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/local/check-tape> ;
    dcterms:references <https://drift-king.org/ah/site/endpoint/local> ;
    dcterms:title "every link on the home page opens, except the /console links, which wait for their gap to be signed" ;
    sd:hasExecutionCommand "node site/checks/check-links.mjs http://127.0.0.1:8787/ ../apricotter/apricotter-microsites/node_modules/playwright" ;
    dcterms:requires <https://drift-king.org/not-ah/node> , <https://drift-king.org/not-ah/npm/playwright/1.61.1> .
<https://drift-king.org/site/checks/check-tape.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/check-links.mjs> a prov:Entity ;
