    rdf:value "The second line of a list." .
<https://drift-king.org/ah/x-components/0.2.0/canary/want/ask> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/x-components/0.2.0/canary/asks> ;
    <https://drift-king.org/ah/x-components/0.2.0/position> 1 ;
    rdfs:label "Canary ask" ;
    skos:notation "L1" ;
    rdf:value "An ask whose name starts with L." .
<https://drift-king.org/ah/site/render-check-release-wanted>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/approval-release-template> ,
