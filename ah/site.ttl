# A part of ah.ttl, imported by it. ah.ttl is the root: its namespace,
# its imports and its agents. The checks run on all the parts together.
<https://drift-king.org/ah/site.ttl>
    a owl:Ontology , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:title "drift-king.org: the site's copies, renders and deploy" .

# ===========================================================================
# drift-king.org (added by the reviewer): the public site. Files only, no
# script. Every page is generated from a template, the model and the commit,
# so its words cannot drift from what was signed. Its deploy waits only for
# its own steps, never for the product checks: a signed page, or a gap page
# that has to be read before it is signed, must go online even while a check
# fails. pid1's deploy stays gated by every check.
# ===========================================================================
<https://drift-king.org/ah/site>
    a prov:SoftwareAgent ;
    dcterms:title "drift-king.org" ;
    dcterms:requires <https://drift-king.org/ah/site/deploy> .

# The source files, all under site/.
<https://drift-king.org/site/wrangler.jsonc> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://developers.cloudflare.com/workers/wrangler/configuration/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> .
<https://drift-king.org/site/templates/index.mustache> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/index-template> ;
    rdfs:comment "The home page. From the Drift King Wild design the lead architect supplied: the example lines are labeled Example, the letter and its proof come from the model and the signed file, the three lines under What we do not do are quoted from the letter, and there is no script." .
<https://drift-king.org/site/templates/letter.mustache> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/letter-template> .
<https://drift-king.org/site/style.css> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://www.w3.org/TR/css/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    rdfs:comment "The design's own tokens and page styles, with its fonts as files instead of embedded data." .
<https://drift-king.org/site/404.html> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://html.spec.whatwg.org/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> .
<https://drift-king.org/site/images/racer.png> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:identifier "sha256:319d6c42f6e91ac96fa759487583833989a00c06c26898c928a92b50c40141a7" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:comment "The kart racer cut-out, taken byte for byte from the Drift King Wild design the lead architect supplied." .

<https://drift-king.org/ah/site/var/letter-text>       a p-plan:Variable ; rdfs:label "the signed letter, as text" .
<https://drift-king.org/ah/site/var/letter-signing>    a p-plan:Variable ; rdfs:label "the letter's signing: date, envelope, sha256" .
<https://drift-king.org/ah/site/var/index-template>    a p-plan:Variable ; rdfs:label "the home page template" .
<https://drift-king.org/ah/site/var/letter-template>   a p-plan:Variable ; rdfs:label "the letter page template" .
<https://drift-king.org/ah/site/var/letter-html>       a p-plan:Variable ; rdfs:label "site/public/intent/letter-of-intent.html" .
<https://drift-king.org/ah/site/var/index-html>        a p-plan:Variable ; rdfs:label "site/public/index.html, the home page that is live now" .
<https://drift-king.org/ah/site/var/copies>            a p-plan:Variable ; rdfs:label "files copied into site/public" .
<https://drift-king.org/ah/site/var/racer-webp>        a p-plan:Variable ; rdfs:label "site/public/images/racer.webp" .
<https://drift-king.org/ah/site/var/kart-webp>         a p-plan:Variable ; rdfs:label "site/public/images/kart.webp" .

# The steps.
<https://drift-king.org/ah/site/render-index>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/index-template> ,
        <https://drift-king.org/ah/site/var/letter-signing> ,
        <https://drift-king.org/ah/site/var/letter-text> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/index-html> ;
    dcterms:title "render the home page that is live now" ;
    dcterms:description "The home page as it is live, from its own template, the signed letter and its signing. It is published while the new home page is held." .
<https://drift-king.org/ah/site/render-letter>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/letter-template> ,
        <https://drift-king.org/ah/site/var/letter-signing> ,
        <https://drift-king.org/ah/site/var/letter-text> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/letter-html> ;
    dcterms:title "render the letter page" .
<https://drift-king.org/ah/site/publish>
    a <https://drift-king.org/ah/the-builder/CopyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/copies> ;
    dcterms:title "copy the signed letter, the styles, the fonts and the 404 page into the site, from the commit" .
<https://drift-king.org/ah/site/webp-racer>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/racer-webp> ;
    dcterms:title "convert the racer to webp" ;
    sd:hasExecutionCommand "mkdir -p site/public/images && ffmpeg -y -i site/images/racer.png -quality 85 site/public/images/racer.webp" ;
    dcterms:requires <https://drift-king.org/not-ah/ffmpeg> .
<https://drift-king.org/ah/site/webp-kart>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/kart-webp> ;
    dcterms:title "convert the orange grove kart to webp" ;
    sd:hasExecutionCommand "mkdir -p site/public/images && ffmpeg -y -i Gemini_Generated_Image_75wd8p75wd8p75wd.jpg -quality 85 site/public/images/kart.webp" ;
    dcterms:requires <https://drift-king.org/not-ah/ffmpeg> .
<https://drift-king.org/ah/site/deploy>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/render-index> ,
        <https://drift-king.org/ah/site/render-letter> ,
        <https://drift-king.org/ah/site/publish> ,
        <https://drift-king.org/ah/site/webp-racer> ,
        <https://drift-king.org/ah/site/webp-kart> ;
    dcterms:title "deploy drift-king.org" ;
    sd:hasExecutionCommand "cd site && npx --yes wrangler@4.145.0 deploy" ;
    dcterms:requires <https://drift-king.org/not-ah/wrangler> .

# Where drift-king.org is served on the lead architect's machine, to try a
# change before it ships. Not a step of the-builder: wrangler dev runs until
# it is stopped. The take-a-release plan starts it, runs its checks against
# the endpoint, and stops it by its PID. It changes nothing outside this
# machine, so it is not a ship step.
<https://drift-king.org/ah/site/endpoint/local>
    a dcat:DataService ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcat:endpointURL <http://127.0.0.1:8787/> ;
    rdfs:comment "drift-king.org served on the lead architect's machine, from site/public. Never public." .
<https://drift-king.org/ah/site/serve-local>
    a sd:SoftwareConfiguration ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:title "serve drift-king.org on this machine" ;
    sd:hasExecutionCommand "cd site && npx --yes wrangler@4.145.0 dev --local --port 8787" ;
    dcterms:requires <https://drift-king.org/not-ah/wrangler> .

# What the steps make, each pointing at its source. The copies carry the
# sha256 they must have; the rendered pages and webp files are checked by
# being generated from pinned inputs.
<https://drift-king.org/site/public/index.html> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/index.mustache> ,
        <https://drift-king.org/site/templates/home.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/index-html> ,
        <https://drift-king.org/ah/site/var/home-html> ;
    rdfs:comment "While the new home page is held, this is the home page that is live now, rendered from index.mustache. Once 0.2.0 is taken, the expand step writes the new one over it." .
