    rdfs:comment "One line for each source file: its path, the address on GitHub it is sent to, and whether a copy of it is published." .
<https://drift-king.org/site/templates/assetsignore.mustache> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
