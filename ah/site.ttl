# drift-king.org's deploy is a ship step: a plain run does not deploy.
<https://drift-king.org/ah/site/deploy> a <https://drift-king.org/ah/the-builder/ShipStep> .

# An approval page that shows what its checks found, as well as its files.
<https://drift-king.org/site/templates/approval-results.mustache>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-results-template> ;
    rdfs:comment "The approval page, plus what each check the document names found in the build that renders it. A new template, so every page already signed keeps rendering from its own." .
<https://drift-king.org/ah/site/var/approval-results-template> a p-plan:Variable ; rdfs:label "the approval template that shows what its checks found" .
<https://drift-king.org/ah/site/var/approval-results> a p-plan:Variable ; rdfs:label "what an approval's checks found" .

# The three checks that can only run once 0.1.0 is on npm. Steps of the plan
# that takes the version; until they run, an approval that names them says so.
<https://drift-king.org/ah/site/x-components/check-provenance>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/keep> ;
    dcterms:title "the published tarball is signed and logged: its npm provenance names this repository and commit, and is in Sigstore's Rekor" .
<https://drift-king.org/ah/site/x-components/check-no-token>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/keep> ;
    dcterms:title "after the first release, no token can publish: the package allows only its own workflow, staged" .
<https://drift-king.org/ah/site/x-components/check-pinned>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/keep> ;
    dcterms:title "Drift King pins one version: the lockfile names exactly the tarball Drift King audited" .

# Every address of ours opens. One that is not a published file answers with
# a 303 See Other to the published file that defines it, as W3C's "Cool URIs
# for the Semantic Web" says an address that names a thing should. The list
# is written from the model on every build, never by hand.
<https://drift-king.org/site/templates/redirects.mustache>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/redirects-template> ;
    rdfs:comment "One line per address: where it is asked for, the file that describes it, and 303." .
<https://drift-king.org/ah/site/var/redirects-template> a p-plan:Variable ; rdfs:label "the redirects template" .
<https://drift-king.org/ah/site/var/redirect-rows>      a p-plan:Variable ; rdfs:label "each address and the file that defines it" .
<https://drift-king.org/ah/site/var/redirects>          a p-plan:Variable ; rdfs:label "site/public/_redirects" .
<https://drift-king.org/ah/site/render-redirects>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/redirects-template> ,
        <https://drift-king.org/ah/site/var/redirect-rows> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/redirects> ;
    dcterms:title "write where each address of ours goes" .
<https://drift-king.org/site/public/_redirects> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/redirects.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/redirects> .
<https://drift-king.org/ah/site/deploy>
    p-plan:isPrecededBy <https://drift-king.org/ah/site/render-redirects> .

# Where the published folder is served from: drift-king.org. The redirects
# send an address to the host its defining file is served from.
# dcat:accessURL's range is rdfs:Resource; drift-king.org is typed cc:Work
# elsewhere, so it says it is a resource too.
<https://drift-king.org/> a rdfs:Resource .
<https://drift-king.org/site/public/> a dcat:Distribution ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcat:accessURL <https://drift-king.org/> .

