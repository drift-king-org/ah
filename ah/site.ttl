# ah.ttl and its parts on the site, for anyone to pull: exactly the
# committed bytes. A file can't carry its own sha256, so the pin is the
# commit; the step prints each hash into the build log. The parts are the
# .ttl files under ah/ at HEAD, so a new part is published without an edit
# here. not-ah.ttl is published too: it names no account, only the setting
# the account is read from.
<https://drift-king.org/ah/site/var/model-copy> a p-plan:Variable ; rdfs:label "site/public/ah.ttl and site/public/ah/" .
<https://drift-king.org/ah/site/publish-model>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/model-copy> ;
    dcterms:title "publish ah.ttl and its parts, as committed" ;
    sd:hasExecutionCommand "mkdir -p site/public/ah && for f in ah.ttl not-ah.ttl $(git ls-tree --name-only HEAD ah/ | grep '\\.ttl$'); do git show \"HEAD:$f\" > \"site/public/$f\" || exit 1; done && sha256sum site/public/ah.ttl site/public/not-ah.ttl site/public/ah/*.ttl" .
<https://drift-king.org/site/public/ah.ttl> a prov:Entity , p-plan:Entity ;
