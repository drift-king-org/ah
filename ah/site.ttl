    sd:hasExecutionCommand "node site/checks/check-quotes.mjs site/checks/canaries/quotes-altered.ttl; test $? -eq 1 && node site/checks/check-quotes.mjs ah/x-components-0.2.0-wanted.ttl" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/site/checks/check-quotes.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/canaries/quotes-altered.ttl> a prov:Entity ;
