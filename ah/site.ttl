    sd:hasExecutionCommand "node site/checks/check-served.mjs http://127.0.0.1:8788/ site/checks/canaries/served/served.tsv site/checks/canaries/served/source.tsv; test $? -eq 1 && node site/checks/check-served.mjs http://127.0.0.1:8787/ site/served.tsv site/source.tsv" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .

# The clean check. It reads the rules from the model, as a file written by a render step, and
# scans after every step that writes under site/public, so nothing is published that it has not
# passed. Canaries first: each rule's canary must be found, or the check is blind.
<https://drift-king.org/ah/site/var/clean-rules> a p-plan:Variable ; rdfs:label "the clean rules, each with its pattern and canary" .
<https://drift-king.org/ah/site/var/clean-rules-file> a p-plan:Variable ; rdfs:label "the-builder/target/clean-rules.tsv" .
