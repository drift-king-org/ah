# ---------------------------------------------------------------------------
# Render check (reviewer): the approval template rendered from fixed canary
# inputs must match a pinned output, byte for byte, before the site deploys.
# A render step whose output carries a dcterms:identifier sha256 checks it and
# exits 1 on any difference. A change to the template or the renderer then
# shows up as a failed check, and the expected file beside the canary shows
# exactly what should have come out.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-linter/canaries/render/approval.md>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://spec.commonmark.org/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-text> ;
    rdfs:comment "Fixed text for the approval template's render check: escaping, a link line, a paragraph over two lines." .
<https://drift-king.org/the-linter/canaries/render/approval.expected.html>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:identifier "sha256:1cb85e07c9ed93cbfd3a801bc20d7a9fba682b40492ef50f4ab45af89e50f1d3" ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    rdfs:comment "What the render check must produce, for reading and diffing. Rendered by the reviewer with chevron, a Mustache implementation that follows the official spec. If the-builder's spec-proven crate renders different bytes, compare the two against the spec before pinning either." .

