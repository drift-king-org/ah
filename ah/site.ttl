# The steps. A render fills a template from the copy; the expander runs only after
# its two tag checks, with the canary of each run first and required to fail.
<https://drift-king.org/ah/site/render-home>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/home-template> ,
        <https://drift-king.org/ah/site/var/home-content> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/home-markup> ;
    dcterms:title "render the home page as x-* markup, from its template and its copy" .
<https://drift-king.org/ah/site/render-home-settings>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/settings-template> ,
        <https://drift-king.org/ah/site/var/home-content> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/settings-json> ;
    dcterms:title "render the expander's settings, from the copy" .
<https://drift-king.org/ah/site/extract-home-images>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/publish> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/home-images> ;
    dcterms:title "take the kart cut-out and the scene out of the signed design zip, as webp" ;
    dcterms:description "The zip is the copy the publish step made, its sha256 checked there against the signed one. Two files come out of it and become webp; the design's HTML is not read." ;
    sd:hasExecutionCommand "mkdir -p site/expander/design site/public/images && unzip -o -j -d site/expander/design site/public/design/drift-king-design-system.zip export/drift-king-landing/assets/kart-sticker-cutout.png export/drift-king-landing/assets/illustration-drift-king-scene.jpg && ffmpeg -y -i site/expander/design/kart-sticker-cutout.png -quality 85 site/public/images/kart-cutout.webp && ffmpeg -y -i site/expander/design/illustration-drift-king-scene.jpg -quality 85 site/public/images/scene.webp" ;
    dcterms:requires <https://drift-king.org/not-ah/ffmpeg> , <https://drift-king.org/not-ah/unzip> .

<https://drift-king.org/ah/site/check-home-tags>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/publish> ;
    dcterms:references <https://drift-king.org/ah/site/x-components/check-tags> ;
    dcterms:title "every tag on the home page is a component the model defines, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-tags.mjs site/checks/canaries/undefined-tag.mustache site/expander/x-components/component.ttl site/expander/x-components/component-attributes.generated.mjs; test $? -eq 1 && node site/checks/check-tags.mjs site/templates/home.mustache site/expander/x-components/component.ttl site/expander/x-components/component-attributes.generated.mjs" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/check-home-only-components>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    dcterms:references <https://drift-king.org/ah/site/x-components/check-only-components> ;
    dcterms:title "the home page is made of components and nothing else, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-only-components.mjs site/checks/canaries/plain-div.mustache; test $? -eq 1 && node site/checks/check-only-components.mjs site/templates/home.mustache" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/expand-home>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/render-index> ,
        <https://drift-king.org/ah/site/render-home> ,
        <https://drift-king.org/ah/site/render-home-settings> ,
        <https://drift-king.org/ah/site/x-components/install-expander> ,
        <https://drift-king.org/ah/site/check-home-tags> ,
        <https://drift-king.org/ah/site/check-home-only-components> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/home-html> ;
    dcterms:references <https://drift-king.org/ah/site/x-components/expand> ;
    dcterms:title "publish the new home page: expand its x-* markup to plain HTML, with drift-king.org as the site domain" ;
    dcterms:description "The new home page runs on x-components 0.2.0, which Drift King has not taken: it uses only a version it has taken. Until a signed taking of 0.2.0 exists, this step is held, and the build publishes the home page that is live now, unchanged." ;
    dcterms:requires <https://drift-king.org/ah/site/x-components/take> ;
    dcterms:references <https://drift-king.org/not-ah/npm/apricotter-x-components/0.2.0> ;
    sd:hasExecutionCommand "cd site/expander && node expand-home.mjs markup/index.html settings.json ../public/index.html" ;
    dcterms:requires <https://drift-king.org/not-ah/node> , <https://drift-king.org/not-ah/npm/cheerio/1.2.0> .
<https://drift-king.org/ah/site/check-home-expanded>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/expand-home> ;
    dcterms:references <https://drift-king.org/ah/site/x-components/check-expanded> ;
    dcterms:title "no page ships with a tag left unexpanded, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-expanded.mjs site/checks/canaries/unexpanded.html; test $? -eq 1 && node site/checks/check-expanded.mjs site/public/index.html" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/check-home-styles>
    a sd:SoftwareConfiguration , p-plan:Step ;
