<https://drift-king.org/ah/site/var/approval-unnamed> a p-plan:Variable ; rdfs:label "the checks no wanted item a release approval names is proved by" .

# Render check for the wanted section of a release approval, from fixed canary inputs.
# Two items of a list and one ask, the ask named with an L, the way a list line is named
# on the real page. Each is part of its own document, with its own position. The page must
# put the list's items first, in their positions, and the ask after them: a place read from a
# name would put the ask first. The output is held to its sha256.
<https://drift-king.org/ah/site/var/render-canary-release-text> a p-plan:Variable ; rdfs:label "the release wanted canary's document, as text" .
<https://drift-king.org/ah/site/var/render-canary-release-html> a p-plan:Variable ; rdfs:label "the release wanted canary's output" .
<https://drift-king.org/the-linter/canaries/render/release-wanted.md> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://spec.commonmark.org/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    dcterms:references <https://drift-king.org/ah/x-components/0.2.0/canary/want/first-line> ,
        <https://drift-king.org/ah/x-components/0.2.0/canary/want/second-line> ,
        <https://drift-king.org/ah/x-components/0.2.0/canary/want/ask> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-release-text> .
<https://drift-king.org/ah/x-components/0.2.0/canary/list> <https://drift-king.org/ah/x-components/0.2.0/position> 1 .
<https://drift-king.org/ah/x-components/0.2.0/canary/asks> <https://drift-king.org/ah/x-components/0.2.0/position> 2 .
<https://drift-king.org/ah/x-components/0.2.0/canary/want/first-line> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/x-components/0.2.0/canary/list> ;
    <https://drift-king.org/ah/x-components/0.2.0/position> 1 ;
    rdfs:label "Canary list item, first" ;
    skos:notation "A1" ;
    rdf:value "The first line of a list." .
<https://drift-king.org/ah/x-components/0.2.0/canary/want/second-line> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/x-components/0.2.0/canary/list> ;
