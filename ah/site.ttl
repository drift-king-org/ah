    prov:wasDerivedFrom <https://drift-king.org/ah/x-components-0.2.0-wanted.ttl> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/model-copy> .
<https://drift-king.org/ah/site/deploy>
    p-plan:isPrecededBy <https://drift-king.org/ah/site/publish-model> .

# ===========================================================================
# drift-king.org, written in x-components. Every page is x-* markup, expanded
# by the pinned @apricotter/x-components at build time into plain files, so
# the site stays files only, with no script. The site's own style.css styles
# the class names the components emit; the package carries no styling.
# Signed pages are the exception: an approval page, and the documents signed
# with it, are served exactly as signed and never rendered again.
#
# This plan is not the builder's yet. Its steps join the builder's plan when
# 0.1.0 is published, audited and taken.
# ===========================================================================
<https://drift-king.org/ah/site>
    dcterms:requires <https://drift-king.org/not-ah/npm/apricotter-x-components> .

<https://drift-king.org/ah/site/x-components/plan>
    a p-plan:Plan ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:title "drift-king.org, written in x-components" ;
    dcterms:description "Take one audited version of @apricotter/x-components, write every page that is not a signed page in its x-* tags, expand them at build time, and ship only when every tag is a component its model defines and none is left unexpanded." .

<https://drift-king.org/ah/site/x-components/var/tarball>  a p-plan:Variable ; rdfs:label "the tarball, as npm published it" .
<https://drift-king.org/ah/site/x-components/var/audit>    a p-plan:Variable ; rdfs:label "the audit: each line of the letter and list, with the check that proves it on the tarball" .
<https://drift-king.org/ah/site/x-components/var/taking>   a p-plan:Variable ; rdfs:label "the signed taking of that version" .
<https://drift-king.org/ah/site/x-components/var/unpacked> a p-plan:Variable ; rdfs:label "the model and the expander, unpacked from the tarball" .
<https://drift-king.org/ah/site/x-components/var/markup>   a p-plan:Variable ; rdfs:label "each page, rendered as x-* markup" .
<https://drift-king.org/ah/site/x-components/var/pages>    a p-plan:Variable ; rdfs:label "each page, expanded into plain HTML" .

<https://drift-king.org/ah/site/x-components/keep>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/tarball> ;
    dcterms:title "keep the tarball" ;
    dcterms:description "Fetch the tarball once, from its download address, and keep it in the repo under vendor/npm/. Its sha256 and npm's integrity go on its node in not-ah.ttl. A build reads the kept file and never the network; a copy whose sha256 differs stops the build." ;
    dcterms:requires <https://drift-king.org/not-ah/npm/apricotter-x-components> .

<https://drift-king.org/ah/site/x-components/audit>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/keep> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/x-components/var/tarball> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/audit> ;
    dcterms:title "audit it against its letter" ;
    dcterms:description "Drift King's own checks, each with its canary, run on the kept tarball. Each claim in the x-components letter and its list points at the check that proves it, as an EARL result on the tarball. A claim no check covers is listed as open. Nothing the package's own checks say is taken on trust." .

<https://drift-king.org/ah/site/x-components/take>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/audit> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/x-components/var/audit> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/taking> ;
    dcterms:title "take it, signed" ;
    dcterms:description "Compliance writes what the audit found, for this version, and it is signed by the current signing plan. Drift King's own work, so the lead architect approves. Drift King uses only a version it has taken." ;
    rdfs:comment "Done by the lead architect, not an agent." .

<https://drift-king.org/ah/site/x-components/unpack>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/take> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/x-components/var/tarball> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/unpacked> ;
    dcterms:title "unpack the model and the expander" ;
    dcterms:description "Unpack component.ttl, wai-aria.ttl, component-attributes.generated.mjs and expand.mjs from the kept tarball, each checked by sha256 against the tarball's own. The catalog maps the component model's and WAI-ARIA's names to the unpacked files, and ah.ttl imports the component model, so the checks can read it offline." .

<https://drift-king.org/ah/site/x-components/render>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/unpack> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/markup> ;
    dcterms:title "render each page as x-* markup" ;
    dcterms:description "The site's templates are written in x-* tags. The render steps fill them from the model as they do today, and their output is x-* markup, not HTML yet. Signed pages keep their own templates and are not rendered again." .

<https://drift-king.org/ah/site/x-components/expand>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/render> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/x-components/var/markup> ,
        <https://drift-king.org/ah/site/x-components/var/unpacked> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/x-components/var/pages> ;
    dcterms:title "expand every page" ;
    dcterms:description "Run the candidate's static entry point, @apricotter/x-components/static, over each rendered page, with drift-king.org as its site domain and the site's words as its settings, and write the plain HTML to site/public/. The entry point is the package's one walker: it needs no HTML rewriter, and its one dependency, cheerio, is pinned in not-ah.ttl with everything it pulls in. It refuses where the rewriter refuses, and a tag the model does not define." .

<https://drift-king.org/ah/site/x-components/check-tags>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/unpack> ;
    dcterms:title "every tag on a page is a component the model defines" ;
    dcterms:description "A check with its canary: every x-* tag in a template is a component in the unpacked component.ttl, and every attribute on it is one that component takes. The canary is a template with one tag the model does not define." .

<https://drift-king.org/ah/site/x-components/check-only-components>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/unpack> ;
    dcterms:title "a page is made of components and nothing else" ;
    dcterms:description "A check with its canary: inside the body of every template that is not a signed page's, every element is an x-* tag. Only the document's own head is plain HTML. The canary is a template with one plain div." .

<https://drift-king.org/ah/site/x-components/check-expanded>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/expand> ;
    dcterms:title "no page ships with a tag left unexpanded" ;
    dcterms:description "A check with its canary: no published page still holds an x-* tag. The canary is a page with one tag the expander was never given." .

<https://drift-king.org/ah/site/x-components/check-styles>
    a p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/site/x-components/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/x-components/expand> ;
    dcterms:title "the site styles only classes the components emit" ;
    dcterms:description "A check with its canary: every class style.css styles is one the pinned version emits. It waits for the list's next version, which names the classes as part of the contract. The canary is a rule for a class no component emits." .

