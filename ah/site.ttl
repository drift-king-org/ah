# ===========================================================================
# Where an address goes. One rule splits them. Source (the-builder, the-linter, plans, and so
# the queries and the canaries inside them) is not served from drift-king.org: each of its
# addresses answers with a 303 to the file on GitHub, at the exact commit the site was built
# from. What is published stays here: approvals, signed documents, the letters, the model's own
# .ttl files, the design. The redirects and the list of what the deploy leaves out are written
# from this rule, never by hand.
# ===========================================================================
<https://drift-king.org/ah/SourceFolder> a owl:Class ;
    rdfs:label "source folder" ;
    rdfs:comment "A folder whose files are source: their addresses answer with a 303 to the file on GitHub at the commit the site was built from, and no copy of them is served from drift-king.org." .
<https://drift-king.org/the-builder/> a prov:Collection , <https://drift-king.org/ah/SourceFolder> ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    rdfs:label "the-builder" .
<https://drift-king.org/the-linter/> a prov:Collection , <https://drift-king.org/ah/SourceFolder> ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    rdfs:label "the-linter" .
<https://drift-king.org/plans/> a prov:Collection , <https://drift-king.org/ah/SourceFolder> ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    rdfs:label "plans" .
<https://drift-king.org/ah/the-builder/build> a prov:Activity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:label "this build" ;
    rdfs:comment "The run in progress. The builder notes on it the commit it is run from, so an address can name the exact file the site was built from." .
<https://drift-king.org/ah/site/read-commit>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    dcterms:title "read the commit the site is built from" ;
    sd:hasExecutionCommand "git rev-parse HEAD" .

# What the source rule writes: the list of source files, the file that keeps their copies out of the
