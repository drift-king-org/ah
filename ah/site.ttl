# The home page's copy. Every word on the page is in this file, the site's words
# for x-components included, and the template holds none. The model names it and
# holds its sha256, so a changed word is a changed file.
<https://drift-king.org/ah/site/var/home-content> a p-plan:Variable ; rdfs:label "the home page's copy" .
<https://drift-king.org/site/content/home.yaml> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://yaml.org/spec/1.2.2/> ;
    dcterms:identifier "sha256:80fc0e547d9011dddb388ee80e478690bf40eaff95be4f5691d64aa6eb5d86e5" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/home-content> ;
    rdfs:comment "The home page's words, and the words x-components is given as settings: what a new-tab link says, and what a table cell says with no value or an empty one." .

# ===========================================================================
# The home page, built from the model, the copy and x-components 0.2.0. The
# template is x-* tags and names a place in home.yaml for every word; the render
# fills it; the expander writes plain HTML to site/public/index.html. Nothing
# is copied from the design's HTML: the kart cut-out and the scene come out of
# the signed zip, checked by its sha256, and become webp by steps.
# ===========================================================================
<https://drift-king.org/ah/site/var/home-template>     a p-plan:Variable ; rdfs:label "the home page template, in x-* tags" .
<https://drift-king.org/ah/site/var/settings-template> a p-plan:Variable ; rdfs:label "the expander's settings template" .
<https://drift-king.org/ah/site/var/home-markup>       a p-plan:Variable ; rdfs:label "the home page as x-* markup" .
<https://drift-king.org/ah/site/var/settings-json>     a p-plan:Variable ; rdfs:label "the expander's settings: the site domain and the site's words" .
<https://drift-king.org/ah/site/var/home-html>         a p-plan:Variable ; rdfs:label "site/public/index.html" .
