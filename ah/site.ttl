# The headers file and the manifest of what is served are generated from the same rows:
# the media type of every published file. Neither is written by hand.
<https://drift-king.org/site/templates/headers.mustache> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/headers-template> ;
    rdfs:comment "One literal rule for each file that needs one: its path, its Content-Type, and its Cache-Control when it has one. No wildcard: a rule with one would apply to an address that is not published, and answer the 404 page in that file's type." .
<https://drift-king.org/site/templates/served.mustache> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/served-template> ;
    rdfs:comment "What the site must answer, a line for each published file: its path, its Content-Type, and whether a rule in the headers file gives it. The checks read this, not the headers file." .
<https://drift-king.org/ah/site/var/headers-template> a p-plan:Variable ; rdfs:label "the headers file's template" .
<https://drift-king.org/ah/site/var/served-template> a p-plan:Variable ; rdfs:label "the manifest of what is served, its template" .
<https://drift-king.org/ah/site/var/published-files> a p-plan:Variable ; rdfs:label "every published file with its media type" .
<https://drift-king.org/ah/site/var/headers-file> a p-plan:Variable ; rdfs:label "site/public/_headers" .
<https://drift-king.org/ah/site/var/served-file> a p-plan:Variable ; rdfs:label "site/served.tsv" .
<https://drift-king.org/ah/site/render-headers>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/headers-template> ,
        <https://drift-king.org/ah/site/var/published-files> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/headers-file> ;
    dcterms:title "generate the headers file from the media type of each published file" .
<https://drift-king.org/ah/site/render-served>
    a <https://drift-king.org/ah/the-builder/RenderStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasInputVar <https://drift-king.org/ah/site/var/served-template> ,
        <https://drift-king.org/ah/site/var/published-files> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/site/var/served-file> ;
    dcterms:title "write the manifest of what the site must answer, from the same rows" .
<https://drift-king.org/site/served.tsv> a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/served.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/served-file> .
<https://drift-king.org/ah/site/check-headers>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/site/render-headers> ,
        <https://drift-king.org/ah/site/render-served> ;
    dcterms:title "the headers file has only literal rules, a rule for each file that needs one, each with the type the model names, canary first" ;
    sd:hasExecutionCommand "node site/checks/check-headers.mjs site/checks/canaries/headers-wildcard/_headers site/checks/canaries/headers-wildcard/served.tsv; test $? -eq 1 && node site/checks/check-headers.mjs site/public/_headers site/served.tsv" ;
    dcterms:requires <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/site/deploy>
    p-plan:isPrecededBy <https://drift-king.org/ah/site/check-headers> .
<https://drift-king.org/site/checks/check-headers.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/canaries/headers-wildcard/_headers> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "The old /the-linter/* rule, a wildcard. check-headers must fail on it." .
<https://drift-king.org/site/checks/canaries/headers-wildcard/served.tsv> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "What the wildcard canary's site must answer." .

# What a running site answers. The check runs against serve-local, and its canary runs against a
# small site of its own that carries the old wildcard rule: it must fail first.
<https://drift-king.org/site/checks/check-served.mjs> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/canaries/served/wrangler.jsonc> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "A small site that carries the wildcard rule, served on its own port so check-served can be run against it first." .
<https://drift-king.org/site/checks/canaries/served/served.tsv> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/canaries/served/public/_headers> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "The old /the-linter/* rule, a wildcard, as a small site serves it. check-served must fail against it." .
<https://drift-king.org/site/checks/canaries/served/public/404.html> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/site> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .
<https://drift-king.org/site/checks/canaries/served/public/the-linter/x.rs> a prov:Entity ;
