# ---------------------------------------------------------------------------
# Ship steps. A step that changes something outside this machine -- a deploy,
# a push, a registry login -- is a ship step, and a plain run of the builder
# does not ship. It verifies: every check, copy and render runs, and each ship
# step says it was not shipped. Shipping takes an explicit --ship.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/the-builder/ShipStep>
    a owl:Class ;
    rdfs:subClassOf p-plan:Step ;
    rdfs:label "ship step" ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:references <https://drift-king.org/the-builder/queries/plan-steps.rq> ;
    rdfs:comment "Changes something outside this machine: a deploy, a push, a registry login or logout. Runs only on a run with --ship." .
<https://drift-king.org/the-builder/message/not-shipped>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/messages> ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    dcterms:description "(not shipped: a verify run; a run with --ship ships it) {{{title}}}" .
<https://drift-king.org/the-builder/name/ship>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "ship" ;
    dcterms:references <https://drift-king.org/the-builder/queries/plan-steps.rq> .
<https://drift-king.org/the-builder/name/ship-option>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "--ship" ;
    rdfs:comment "The one option that lets a run ship." .
<https://drift-king.org/the-builder/name/dry-run-option>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "--dry-run" ;
    rdfs:comment "The option that lists the plan's steps and runs none of them." .
<https://drift-king.org/the-builder/name/catalog-option>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "--catalog" ;
    rdfs:comment "The option naming the catalog file every import resolves through." .

<https://drift-king.org/the-builder/queries/approval-results.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "what the checks an approval names found, in the build that renders it" ;
    skos:notation "results" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-results> .
<https://drift-king.org/the-builder/name/key>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "key" ;
    dcterms:references <https://drift-king.org/the-builder/queries/render-inputs.rq> .
# the-builder asserts what each check found, in the run that ran it.
<https://drift-king.org/ah/the-builder> a earl:Assertor .

# Where an address of ours goes when it is not a published file: to the
# published file that defines it, by rdfs:isDefinedBy, which the-builder
# records from each file of ours read alone.
<https://drift-king.org/the-builder/queries/redirects.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "each address of ours that is not a published file, and the published file that defines it" ;
    dcterms:references <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/redirect-rows> .

# The queries a release approval's page is rendered from: what its checks found
# on the subjects it names, and the packages it brings with their integrities.
<https://drift-king.org/the-builder/queries/approval-release-results.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "what the checks a release approval names found, on the subjects it names" ;
    skos:notation "results" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-release-results> .
<https://drift-king.org/the-builder/queries/approval-dependencies.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "the packages a release approval names, and what they bring, with their versions and integrities" ;
    skos:notation "packages" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-packages> .

<https://drift-king.org/the-builder/queries/approval-wanted.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "what a release approval's document wanted, beside the checks that prove it and what they found" ;
    skos:notation "wanted" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-wanted> .

<https://drift-king.org/the-builder/queries/approval-unnamed-checks.rq>
    a dcat:Resource , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:title "the checks a release approval's candidate was given that no wanted item it names is proved by" ;
    skos:notation "unnamed" ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-unnamed> .

<https://drift-king.org/the-builder/message/untaken>
