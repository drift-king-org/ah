# ---------------------------------------------------------------------------
# What the-builder runs itself (string gap, group 3): each command is a
# Mustache template the code fills by IRI, run through the shell the model
# names for the system. The code spells no program, no option and no path.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-builder/commands>
    a skos:ConceptScheme ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    skos:prefLabel "what the-builder runs"@en .
<https://drift-king.org/the-builder/command/git-show>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "the file as committed" ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    sd:hasExecutionCommand "git show 'HEAD:{{{source}}}'" .
<https://drift-king.org/the-builder/command/sha256sum>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "a file's sha256" ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    sd:hasExecutionCommand "sha256sum '{{{target}}}'" .
<https://drift-king.org/the-builder/command/ast-grep-scan>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "every match of an ast-grep rule in a folder" ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    sd:hasExecutionCommand "ast-grep scan --rule '{{{rule}}}' --json=compact '{{{folder}}}'" .
<https://drift-king.org/the-builder/command/list-files>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "every file in the repo, committed or not, but not ignored" ;
    dcterms:conformsTo <https://mustache.github.io/mustache.5.html> ;
    sd:hasExecutionCommand "git ls-files -co --exclude-standard" .
<https://drift-king.org/the-builder/shell/posix>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "the shell every command runs in, on Linux and macOS" ;
    sd:hasExecutionCommand "sh" .
<https://drift-king.org/the-builder/shell/windows>
    a sd:SoftwareConfiguration , skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/commands> ;
    rdfs:comment "the shell every command runs in, on the lead architect's Windows machine: Git Bash" ;
    sd:hasExecutionCommand "C:\\Program Files\\Git\\bin\\bash.exe" .

# The names group 3 adds: the words that are part of a query, a shell or a file format.
<https://drift-king.org/the-builder/name/conformsTo>
    a skos:Concept ;
