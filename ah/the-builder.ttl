@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sd:      <https://w3id.org/okn/o/sd#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix earl:    <http://www.w3.org/ns/earl#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# A part of ah.ttl, imported by it. ah.ttl is the root: its namespace,
# its imports and its agents. The checks run on all the parts together.
<https://drift-king.org/ah/the-builder.ttl>
    a owl:Ontology , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:title "the-builder: its plan, names, messages and commands" .

# ---------------------------------------------------------------------------
# The plan. The old single "lint" step is gone -- each check is now its own
# pair of steps (not-ah.ttl), and the build steps below are preceded by the
# last of that chain, transitively covering all of them. the-builder/build
# is deliberately not a member: building the builder is a separate job.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/the-builder/plan>
    a p-plan:Plan ;
    dcterms:title "build and deploy cloudflare-pid-rs" .

# A copy step (added by the reviewer): publishes files from the commit. The
# model holds only pointers: each output copy says which file it comes from
# (prov:wasDerivedFrom), where it goes (its own IRI) and the sha256 it must
# have (dcterms:identifier). the-builder reads them with publish-copies.rq,
# takes the bytes from the commit and exits 1 on any mismatch.
<https://drift-king.org/ah/the-builder/CopyStep>
    a owl:Class ;
    rdfs:subClassOf p-plan:Step ;
    rdfs:label "copy step" ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:references <https://drift-king.org/the-builder/queries/publish-copies.rq> .

# ---------------------------------------------------------------------------
# the-builder: the one command that builds drift-king from its own model.
# No dcterms:source yet, same reason as cloudflare-pid-rs: no remote chosen.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/the-builder>
    a prov:SoftwareAgent ;
    dcterms:requires <https://drift-king.org/ah/the-builder/build> .

<https://drift-king.org/ah/the-builder/build>
    a sd:SoftwareConfiguration ;
    dcterms:title "run the-builder" ;
    # Not "cd the-builder && ...": catalog-v001.xml's paths are relative to
    # where the catalog itself lives (drift-king root), same convention as
    # ah-workbench's own CATALOG_FILE. cargo run --manifest-path builds and
    # runs the binary without changing the caller's cwd (verified: it isn't
    # the manifest's directory), so the-builder sees the repo root as cwd.
    sd:hasExecutionCommand "cargo run --release --manifest-path the-builder/Cargo.toml -- --catalog catalog-v001.xml" ;
    dcterms:requires <https://drift-king.org/not-ah/rustc> .

<https://drift-king.org/the-builder/Cargo.toml> dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://doc.rust-lang.org/cargo/reference/manifest.html> .
<https://drift-king.org/the-builder/rust-toolchain.toml> dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://rust-lang.github.io/rustup/overrides.html#the-toolchain-file> .
<https://drift-king.org/the-builder/src/main.rs> dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:conformsTo <https://doc.rust-lang.org/reference/> .

<https://drift-king.org/the-builder/proof/B1-domain-retypes.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: domain-retypes findings, canary and real model, with the vocab schemas actually loaded." .
<https://drift-king.org/the-builder/proof/H0-first-commit.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: repo-local git identity, pre-commit checks, and the tree hash of the first commit." .
<https://drift-king.org/the-builder/proof/H1-named-by-nobody.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: named-by-nobody moved into the-linter/checks/ as a real recursive-scan check, with a canary; both verified clean." .
<https://drift-king.org/the-builder/proof/H1-byte-exact.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: git's autocrlf had altered M2-sha256.txt's committed bytes; fixed with core.autocrlf=false and a whole-repo .gitattributes, git ls-files --eol pasted in full." .
<https://drift-king.org/the-builder/proof/H2-code-strings-named.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: code-strings-named and namespace-terms-defined ported from ah-workbench; Rust/JS ast-grep rules verified empirically; all 9 canaries pass; a real cross-check bug (named-by-nobody's multi-base regression) caught and fixed. Superseded/labelled informational by M0-close-h2.txt." .
<https://drift-king.org/the-builder/proof/M0-close-h2.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: Rust rule now catches concat!/format! as one joined unit and excludes extern \"C\"; joined-words canary rewritten in valid Rust; H2's ad hoc-harness results labelled informational." .
<https://drift-king.org/the-builder/proof/M1-vendored-vocab.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: nine vocabularies vendored into the-builder/vocab/ with sha256-verified copies; both checks pass reading only the local copies, no network." .
<https://drift-king.org/the-builder/proof/M2-catalog-loading.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: the-builder loads ah.ttl and every owl:imports it reaches, transitively, only through catalog-v001.xml; a real gap (SKOS and PROV-O's other name) surfaced by running it, not by re-reading the imports by hand." .
<https://drift-king.org/the-builder/proof/M3-p-plan-checks.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: the plan is P-Plan; every check is a canary-step and a real-step, no SPARQL in main.rs; real bugs found and fixed (earl.rdf's xml:base, p-plan:Entity/earl:TestCriterion/earl:TestSubject typing, ?base bound by the caller); full real run, all checks pass or open-gap." .
<https://drift-king.org/the-builder/proof/M3-code-strings-named-gap.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:isReplacedBy <https://drift-king.org/the-builder/proof/M3.1-code-strings-named-gap.txt> ;
    rdfs:comment "Superseded (M3.1): undercounted at 23, all in cloudflare-pid-rs/worker/src/index.js. code-strings-named.rq's address check silently accepted any string with a colon and a space or brace as a matched address (IRI() errors, the unbound ?address then matches every triple), hiding the 7 in cloudflare-pid-rs/pid1/src/main.rs. Found by the reviewer, verified in pyoxigraph 0.5.11." .
<https://drift-king.org/the-builder/proof/M3.1-code-strings-named-gap.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:isReplacedBy <https://drift-king.org/the-builder/proof/code-strings-named-all.txt> ;
    rdfs:comment "Superseded (M3.7): scoped to cloudflare-pid-rs only, 30 rows. M3.7 put the-builder/src in scope, adding 127 more." .
<https://drift-king.org/the-builder/proof/code-strings-named-all.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: the-builder's own itemized code-strings-named output across every folder in scope -- 157 rows: 7 in cloudflare-pid-rs/pid1/src/main.rs, 23 in cloudflare-pid-rs/worker/src/index.js, 127 in the-builder/src/main.rs." .
<https://drift-king.org/the-builder/proof/M3.1-two-holes-fixed.txt>
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Evidence: the COALESCE fix to code-strings-named.rq's address check, its canary, and the signed-gap redesign (known-gap.rq requires a real prov:Activity, not just an attributed node); the canary-isolation collision the gap node caused, and the reviewer's fix to canary-isolation.rq; full run, only code-strings-named fails, unsigned, as intended." .
<https://drift-king.org/the-builder/src/main.rs> a earl:TestSubject , prov:Entity .

<https://drift-king.org/the-builder/Cargo.lock> dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    rdfs:comment "Written by cargo, never by hand; committed so builds are --locked." .

# A render step: fills a Mustache template. Its inputs' roles come from what
# each conforms to (render-inputs.rq): the template, a SPARQL query whose first
# row is the data, and a CommonMark text split into a title and paragraphs.
<https://drift-king.org/ah/the-builder/RenderStep>
    a owl:Class ;
    rdfs:subClassOf p-plan:Step ;
    rdfs:label "render step" ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:references <https://drift-king.org/the-builder/queries/render-inputs.rq> .

<https://drift-king.org/the-builder/queries/letter-signing.rq> a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/letter-signing> .
<https://drift-king.org/the-builder/queries/approval-files.rq>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/approval-files> .
<https://drift-king.org/the-builder/queries/canary-approval-files.rq>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-rows> .
<https://drift-king.org/the-builder/target/render-check/approval.html>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:identifier "sha256:1cb85e07c9ed93cbfd3a801bc20d7a9fba682b40492ef50f4ab45af89e50f1d3" ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/approval.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-html> .

# Render checks for the letter and home templates (reviewer, M3.13). M3.8
# changed how query rows reach a template, and these two pages went live with
# an empty date, envelope and sha256 because nothing rendered them from fixed
# inputs. Now each is rendered from the same canary text and fixed rows, and
# its output must match the pinned sha256, before the real page is rendered.
<https://drift-king.org/the-builder/queries/canary-letter-signing.rq>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/not-ah/the-linter> ;
    dcterms:conformsTo <https://www.w3.org/TR/sparql11-query/> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-signing> .
<https://drift-king.org/the-builder/target/render-check/letter.html>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:identifier "sha256:ae86d276604d766677650f8c0f9b9089ccb479b22dc99dd7ffed6de355892d15" ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/letter.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-letter-html> .
<https://drift-king.org/the-builder/target/render-check/index.html>
    a prov:Entity , p-plan:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:identifier "sha256:ea0d84098f909a3eab7386d2d351afbe5f8d6b1e78f6d85a05d31439e2922749" ;
    prov:wasDerivedFrom <https://drift-king.org/site/templates/index.mustache> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/site/var/render-canary-index-html> .

# ---------------------------------------------------------------------------
# Ready to deploy (Compliance, from the signed model review responses: "The
# site deploy waits for every check"). A ready step runs after every check.
# A failed check stops it, and everything after it. A signed gap does not:
# the step names each one it proceeds with, and a gap's hold ends here, so the
# gap holds only what comes after its own check, not the site.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/the-builder/ReadyStep>
    a owl:Class ;
    rdfs:subClassOf p-plan:Step ;
    rdfs:label "ready step" ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    dcterms:references <https://drift-king.org/the-builder/queries/plan-steps.rq> ;
    rdfs:comment "Runs after every check step of its plan. Fails if any check failed; otherwise passes, naming each open signed gap it proceeds with." .

# ---------------------------------------------------------------------------
# The names the code shares with the model (string gap, group 1). Each is a
# word the code has to spell because something in the model already uses
# it: a variable a query selects, a key a template reads, a field of
# ast-grep's JSON output, or an attribute of the OASIS catalog. Each names
# where it is defined, so none is a word added only so a string passes.
# ---------------------------------------------------------------------------
<https://drift-king.org/the-builder/names>
    a skos:ConceptScheme ;
    dcterms:isPartOf <https://drift-king.org/ah/the-builder> ;
    skos:prefLabel "the names the code shares with the model"@en .
<https://drift-king.org/the-builder/name/base>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "base" ;
    dcterms:references <https://drift-king.org/the-builder/queries/approval-files.rq> ,
        <https://drift-king.org/the-builder/queries/code-scope.rq> ,
        <https://drift-king.org/the-builder/queries/letter-signing.rq> ,
        <https://drift-king.org/the-builder/queries/publish-copies.rq> ,
        <https://drift-king.org/the-builder/queries/render-inputs.rq> ,
        <https://drift-king.org/the-linter/checks/approvals-are-documents.rq> ,
        <https://drift-king.org/the-linter/checks/canary-isolation.rq> ,
        <https://drift-king.org/the-linter/checks/code-strings-named.rq> ,
        <https://drift-king.org/the-linter/checks/domain-retypes.rq> ,
        <https://drift-king.org/the-linter/checks/file-provenance.rq> ,
        <https://drift-king.org/the-linter/checks/iri-names-not-values.rq> ,
        <https://drift-king.org/the-linter/checks/named-by-nobody.rq> ,
        <https://drift-king.org/the-linter/checks/range-retypes.rq> ,
        <https://drift-king.org/the-linter/checks/terms-defined-in-vocab.rq> .
<https://drift-king.org/the-builder/name/before>
    a skos:Concept ;
    skos:inScheme <https://drift-king.org/the-builder/names> ;
    skos:prefLabel "before" ;
    dcterms:references <https://drift-king.org/the-builder/queries/step-precedes.rq> .
<https://drift-king.org/the-builder/name/byteOffset>
