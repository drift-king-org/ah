# The folder where Compliance leaves directives for the coder. Each file in it is named in
# the model, with its sha256, when it is first read; until then it is expected, not a failure.
# A file anywhere else that no statement names still fails named-by-nobody.
<https://drift-king.org/ah/IntakeFolder> a owl:Class ;
    rdfs:label "intake folder" ;
    rdfs:comment "A folder whose files arrive unnamed and are named in the model when they are first read." .
<https://drift-king.org/directives/> a prov:Collection , <https://drift-king.org/ah/IntakeFolder> ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    rdfs:label "directives" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    rdfs:comment "Where Compliance leaves directives for the coder. Each file here is named in the model, with its sha256, when it is first read." .

# A directive left for the coder, named when first read: each file's type comes from the model.
<https://drift-king.org/directives/headers-from-the-model.md> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/directives/> ;
    dcterms:conformsTo <https://spec.commonmark.org/> ;
    dcterms:identifier "sha256:1d402d953ebe33c2cf57372aaafc4b32b13eb42d13ca427717db4778f010010e" ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/lead-architect> ;
    rdfs:comment "Every published file says its media type, and the headers file is generated from those types." .

# ---------------------------------------------------------------------------
# The file-provenance gap's node (Compliance), added now that it is signed (envelope
# 1c5f23e0-819d-84db-8094-3ca551a90138). Its test is the check that exists and is not yet wired into the
# build: the gap is failed by hand (earl:manual), not by a check that ran. It is closed in a later
# change, never in the one that opens it.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/gap/file-provenance>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/file-provenance.rq> ;
    earl:subject <https://drift-king.org/ah.ttl> ;
    earl:mode earl:manual ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "file-provenance: a written file is not yet checked to have a signed packet" ;
    dcterms:title "The file-provenance check exists and is not wired into the build, so a file written with no signed packet does not fail it" ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 438 ; oa:end 472 ] ] ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .

# The x-components sub-dependency gap's node (Compliance), added now that it is signed (envelope
# c2412395-5e34-8007-8175-eca523a201a9). Its test is the check its document names, which does not exist
# yet: every package an install of x-components runs is shipped in the release or pinned to the exact
# version that was checked. The gap is failed by hand (earl:manual).
<https://drift-king.org/not-ah/the-linter/gap/x-components-sub-dependencies>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/install-pinned.rq> ;
    earl:subject <https://drift-king.org/not-ah/npm/apricotter-x-components/0.2.0> ;
    earl:mode earl:manual ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "x-components-sub-dependencies: cheerio's own dependencies float" ;
    dcterms:title "An install of x-components 0.2.0 can receive newer versions of cheerio's 22 dependencies than the ones checked" ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/x-components-letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 557 ; oa:end 630 ] ] ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .

# The check the sub-dependency gap names, before it is written: named here, so its address opens on this
# file and says it does not exist yet.
<https://drift-king.org/the-linter/checks/install-pinned.rq>
    rdfs:comment "Not written yet. The check that will close the sub-dependency gap: every package an install of x-components runs is either shipped in the release or pinned to the exact version that was checked, and a canary with one dependency at a range must fail it." .

# ---------------------------------------------------------------------------
# The file-provenance gap, signed (envelope 1c5f23e0-819d-84db-8094-3ca551a90138). Drift King's own work:
# Compliance signed first and the lead architect second. Read back by Compliance: status completed, both
# signers, every custom field equal to its hash. It accepts the gap, so the signing uses the gap node
# itself and known-gap.rq counts it.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/signing/gap-file-provenance>
    a prov:Activity ;
    prov:used [ a prov:Entity ;
          prov:specializationOf <https://drift-king.org/approvals/gap-file-provenance.md> ;
          dcterms:identifier "sha256:1d360c25061070670566aa15610bc4a1edf21f254adbe4e8a29dfb950d107ff7" ] ,
        [ a prov:Entity ;
          prov:specializationOf <https://drift-king.org/site/public/approvals/gap-file-provenance-approval.html> ;
          dcterms:identifier "sha256:e2f07b3408c0be4ec2be9d594cba55f5b25ba06d0f971813248a675b206454fe" ] ,
        <https://drift-king.org/not-ah/the-linter/gap/file-provenance> ;
    prov:wasAssociatedWith <https://drift-king.org/ah/agent/compliance> ,
        <https://drift-king.org/ah/agent/lead-architect> ;
    prov:endedAtTime "2026-10-01T23:20:26.603Z"^^xsd:dateTime ;
    dcterms:identifier "docusign-dev:envelope:1c5f23e0-819d-84db-8094-3ca551a90138" ;
    # Opens only for users of the demo account; never linked from the site.
    rdfs:seeAlso <https://apps-d.docusign.com/send/documents/details/1c5f23e0-819d-84db-8094-3ca551a90138> .

# The x-components sub-dependency gap, signed (envelope c2412395-5e34-8007-8175-eca523a201a9). Client
# work: Compliance signed first and Apricotter's approver second. Read back by Compliance: status
# completed, both signers, every custom field equal to its hash. It accepts the gap, so the signing uses
# the gap node itself and known-gap.rq counts it. A departure from the rule that a custom field is named
# for its document: DocuSign caps a custom field name at 50 characters, so the approval page's field is
# named gap-x-components-sub-dependencies-approval-sha256, without ".html".
<https://drift-king.org/ah/signing/gap-x-components-sub-dependencies>
    a prov:Activity ;
    prov:used [ a prov:Entity ;
          prov:specializationOf <https://drift-king.org/approvals/gap-x-components-sub-dependencies.md> ;
          dcterms:identifier "sha256:1869e1e204aefc12b80f7b57365e6899538f8f74836c00ed3d89a9e108bd501c" ] ,
        [ a prov:Entity ;
          prov:specializationOf <https://drift-king.org/site/public/approvals/gap-x-components-sub-dependencies-approval.html> ;
          dcterms:identifier "sha256:02788ca80d48588d1795c0e91110f5302dbc5de24094e784fd13c63d75fbbdd9" ] ,
        <https://drift-king.org/not-ah/the-linter/gap/x-components-sub-dependencies> ;
    prov:wasAssociatedWith <https://drift-king.org/ah/agent/compliance> ,
        <https://drift-king.org/ah/agent/client/apricotter> ;
    prov:endedAtTime "2026-10-01T23:22:37.400Z"^^xsd:dateTime ;
    dcterms:identifier "docusign-dev:envelope:c2412395-5e34-8007-8175-eca523a201a9" ;
    rdfs:comment "DocuSign caps a custom field name at 50 characters, so the approval page's field was named gap-x-components-sub-dependencies-approval-sha256, without .html." ;
    # Opens only for users of the demo account; never linked from the site.
    rdfs:seeAlso <https://apps-d.docusign.com/send/documents/details/c2412395-5e34-8007-8175-eca523a201a9> .
