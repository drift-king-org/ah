# ---------------------------------------------------------------------------
# The ship gap's node (Compliance), added now that it is signed: an agreement
# cannot go live on its own, because the site ships as one upload. Its test is
# the check that will close it, which does not exist yet; the gap is failed by
# hand (earl:manual), not by a check that ran. It is closed in a later change,
# never in the one that opens it.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/gap/ship-agreements>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/agreements-ship-alone.rq> ;
    earl:subject <https://drift-king.org/ah.ttl> ;
    earl:mode earl:manual ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "ship-agreements: an agreement cannot go live on its own" ;
    dcterms:title "Publishing an agreement ships every projection committed since the last ship" ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 198 ; oa:end 265 ] ] ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .

# The check the ship gap names, before it is written: named here, so its address
# opens on this file and says it does not exist yet.
<https://drift-king.org/the-linter/checks/agreements-ship-alone.rq>
    rdfs:comment "Not written yet. The check that will close the ship gap: an agreement upload holds only agreements, their approval pages and what they link, and a canary with one projection in it must fail it." .

