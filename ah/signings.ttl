# A part of ah.ttl, imported by it. ah.ttl is the root: its namespace,
# its imports and its agents. The checks run on all the parts together.
<https://drift-king.org/ah/signings.ttl>
    a owl:Ontology , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:title "the signings: gaps, approvals and envelopes, only ever added to" .

<https://drift-king.org/intent/letter-of-intent.md> dcterms:isPartOf <https://drift-king.org/ah> ;
    rdfs:comment "The founding intent, signed by the lead architect: nothing is built or run unless the model names it." .

<https://drift-king.org/.claude/skills/docusign-approval/SKILL.md> a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    dcterms:references <https://drift-king.org/ah/docusign-approval/plan> ;
    rdfs:comment "Says only how to walk the current signing plan: the one nothing replaces. The steps live in the plan, not here." .
<https://drift-king.org/approvals/gap-code-strings-named.txt>
    dcterms:isPartOf <https://drift-king.org/ah> ;
    rdfs:comment "What goes to DocuSign to sign the gap above. Until it comes back signed (a prov:Activity with prov:endedAtTime, prov:wasAssociatedWith a prov:Person, and a docusign-dev:envelope:... dcterms:identifier), known-gap.rq finds nothing for this pair and code-strings-named/real-step fails the build. That is correct, not a bug." .

# ---------------------------------------------------------------------------
# The code-strings-named gap (M3.1): a fact about the build's current state,
# not about the-linter's own machinery, so it lives here, not in not-ah.ttl.
# Also an earl:Assertion for (code-strings-named.rq, ah.ttl) -- expected-
# outcome.rq excludes it (it is not earl:assertedBy not-ah/the-linter), and
# known-gap.rq requires the signing prov:Activity below before it counts.
# Writing this node is free; it does not excuse the failure on its own.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/gap/code-strings-named-cloudflare-pid-rs>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/code-strings-named.rq> ;
    earl:subject <https://drift-king.org/ah.ttl> ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "code-strings-named: unnamed strings in cloudflare-pid-rs and the-builder" ;
    dcterms:title "Unnamed strings in the code" ;
    rdfs:comment "First found when M3 actually ran this check for real: 7 in cloudflare-pid-rs/pid1/src/main.rs, 23 in cloudflare-pid-rs/worker/src/index.js (M3-code-strings-named-gap.txt, since superseded, then corrected to 30 real findings in M3.1 after fixing code-strings-named.rq's own blind spot -- M3.1-code-strings-named-gap.txt). M3.7 put the-builder/src in scope too: 127 more, 157 in all, itemized in the-builder/proof/code-strings-named-all.txt (the-builder's own output, the current evidence)." ;
    prov:wasDerivedFrom [ a prov:Entity ;
        prov:specializationOf <https://drift-king.org/ah.ttl> ;
        dcterms:identifier "sha256:002faadcc1bc5114c6e08594189acf23f735c372aaddf28c876d79def7ea7117" ;
        rdfs:comment "ah.ttl as committed at M3 (f9a7855) -- the version that had this finding." ] ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 67 ; oa:end 117 ] ;
        rdfs:comment "\"Nothing is built or run unless the model names it.\" -- the intent span this gap waives, for now." ] ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/coder> .

# ---------------------------------------------------------------------------
# The second code-strings-named gap (M3.2, added by the reviewer): the check
# has never scanned the-builder/src. The folders it reads are written into
# main.rs, not named here. earl:untested, not failed: nothing ran. It excuses
# no failure; it records that this part of the code is unchecked.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/gap/code-strings-named-the-builder>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/code-strings-named.rq> ;
    earl:subject <https://drift-king.org/the-builder/src/main.rs> ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "code-strings-named: unnamed strings in the-builder/src" ;
    dcterms:title "Unnamed strings in the-builder" ;
    rdfs:comment "M3.7 put the-builder/src in scope for real (code-scope.rq, ingest_source_folder): 127 findings, itemized in the-builder/proof/code-strings-named-all.txt alongside pid1/src (7) and worker/src (23), 157 in all. No longer untested -- this and the cloudflare-pid-rs gap now cover the same real-step; either closes when the strings are named and the check passes." ;
    prov:wasDerivedFrom [ a prov:Entity ;
        prov:specializationOf <https://drift-king.org/the-builder/src/main.rs> ;
        dcterms:identifier "sha256:61ab286743d15760677ba2932660db36f2e903e9da0181669413f1ecd4a1ee64" ;
        rdfs:comment "main.rs as committed at M3.7, after fixing the extracted-strings node-IRI collision (a bare per-call index collided across folders sharing a class) -- every milestone that touches main.rs has to redo this update, since its hash and this citation can't both be fixed in the same commit that changes the file." ] ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 67 ; oa:end 117 ] ] ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> .

<https://drift-king.org/approvals/gap-code-strings-named-the-builder.txt>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    prov:wasAttributedTo <https://drift-king.org/not-ah/agent/reviewer> ;
    rdfs:comment "What the lead architect signs for the gap above, by walking ah/docusign-approval/plan." .

