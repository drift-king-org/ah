# ---------------------------------------------------------------------------
# The open-agreements gap (Compliance), seen by hand on 2026-09-30: the model
# cannot say which agreements are open, and two signings (#15, #16) had
# reached DocuSign and not ah. Drift King's own work: the lead architect signs
# second. Its test is the query that will close it, which does not exist yet;
# the gap is failed by hand (earl:manual), not by a check that ran.
# ---------------------------------------------------------------------------
<https://drift-king.org/not-ah/the-linter/gap/open-agreements>
    a earl:Assertion , prov:Entity , oa:Annotation ;
    earl:test <https://drift-king.org/the-linter/checks/open-agreements.rq> ;
    earl:subject <https://drift-king.org/ah.ttl> ;
    earl:mode earl:manual ;
    earl:result [ a earl:TestResult ; earl:outcome earl:failed ] ;
    rdfs:label "open-agreements: the model cannot say which agreements are open" ;
    dcterms:title "The model does not know what Drift King is working on" ;
    oa:hasTarget [ a oa:SpecificResource ;
        oa:hasSource <https://drift-king.org/intent/letter-of-intent.md> ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 299 ; oa:end 337 ] ] ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> .

<https://drift-king.org/approvals/gap-open-agreements.md>
    a prov:Entity , p-plan:Entity , oa:Annotation ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:conformsTo <https://spec.commonmark.org/> ;
    prov:wasAttributedTo <https://drift-king.org/ah/agent/compliance> ;
    dcterms:subject <https://drift-king.org/not-ah/the-linter/gap/open-agreements> ;
    rdfs:label "The open-agreements gap, exactly as above" ;
