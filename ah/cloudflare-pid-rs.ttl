# A part of ah.ttl, imported by it. ah.ttl is the root: its namespace,
# its imports and its agents. The checks run on all the parts together.
<https://drift-king.org/ah/cloudflare-pid-rs.ttl>
    a owl:Ontology , prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah> ;
    dcterms:title "cloudflare-pid-rs: pid1, the Worker, the image, and what the Worker observes" .

# The smallest thing that proves the platform: a PID 1 for Cloudflare
# Containers. No dcterms:source yet — this repo has no remote to point at
# until a remote is chosen. Its own requirements (tool pins, build/deploy
# steps) are added as they are proven, not in advance.
<https://drift-king.org/ah/cloudflare-pid-rs>
    a prov:SoftwareAgent ;
    dcterms:requires <https://drift-king.org/not-ah/rustc> ,
        <https://drift-king.org/not-ah/cargo-zigbuild> ,
        <https://drift-king.org/not-ah/zig> ,
        <https://drift-king.org/not-ah/crane> ,
        <https://drift-king.org/not-ah/wrangler> ,
        <https://drift-king.org/not-ah/crate/nix> ,
        <https://drift-king.org/not-ah/crate/libc> ,
        <https://drift-king.org/not-ah/npm/cloudflare-containers> ,
        <https://drift-king.org/ah/cloudflare-pid-rs/deploy> .

# ---------------------------------------------------------------------------
# pid1's own words. main.rs may hold a string only if it is named here, or is
# an address, the way the-generator's code is held to the model. A label here
# is the string exactly as pid1 compiles it in, a std::fmt format string where
# it has holes; code-strings-named.rq holds main.rs to it.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/cloudflare-pid-rs/message/started>
    a owl:NamedIndividual ;
    rdfs:label "pid1: started pid={}" ;
    dcterms:conformsTo <https://doc.rust-lang.org/std/fmt/> .

<https://drift-king.org/ah/cloudflare-pid-rs/message/sigterm>
    a owl:NamedIndividual ;
    rdfs:label "pid1: SIGTERM received, exiting" .

<https://drift-king.org/ah/cloudflare-pid-rs/message/install-handler>
    a owl:NamedIndividual ;
    rdfs:label "pid1: failed to install {signal:?} handler: {e}" ;
    dcterms:conformsTo <https://doc.rust-lang.org/std/fmt/> .

<https://drift-king.org/ah/cloudflare-pid-rs/message/block-signals>
    a owl:NamedIndividual ;
    rdfs:label "pid1: failed to block signals" .

<https://drift-king.org/ah/cloudflare-pid-rs/message/clock>
    a owl:NamedIndividual ;
    rdfs:label "pid1: clock before epoch" .

<https://drift-king.org/ah/cloudflare-pid-rs/message/bind>
    a owl:NamedIndividual ;
    rdfs:label "pid1: failed to bind :8080" .

<https://drift-king.org/ah/cloudflare-pid-rs/response/pid>
    a owl:NamedIndividual ;
    rdfs:label "pid" ;
    rdfs:comment "Response field: std::process::id()." .

<https://drift-king.org/ah/cloudflare-pid-rs/response/started>
    a owl:NamedIndividual ;
    rdfs:label "started" ;
    rdfs:comment "Response field: unix seconds at boot." .

<https://drift-king.org/ah/cloudflare-pid-rs/response/location>
    a owl:NamedIndividual ;
    rdfs:label "location" ;
    rdfs:comment "Response field: CLOUDFLARE_LOCATION, or \"\" if unset." .

<https://drift-king.org/ah/cloudflare-pid-rs/response/durable_object>
    a owl:NamedIndividual ;
    rdfs:label "durable_object" ;
    rdfs:comment "Response field: CLOUDFLARE_DURABLE_OBJECT_ID, or \"\" if unset." .

# Cloudflare's own words, not ours: named here, defined there.
<https://drift-king.org/ah/cloudflare-pid-rs/env/location>
    a owl:NamedIndividual ;
    rdfs:label "CLOUDFLARE_LOCATION" ;
    rdfs:isDefinedBy <https://developers.cloudflare.com/containers/platform-details/environment-variables/> ;
    rdfs:comment "A name of a location the container is placed in." .

<https://drift-king.org/ah/cloudflare-pid-rs/env/durable-object-id>
    a owl:NamedIndividual ;
    rdfs:label "CLOUDFLARE_DURABLE_OBJECT_ID" ;
    rdfs:isDefinedBy <https://developers.cloudflare.com/containers/platform-details/environment-variables/> ;
    rdfs:comment "The ID of the Durable Object instance the container is bound to." .

<https://drift-king.org/ah/cloudflare-pid-rs/listen-address>
    a owl:NamedIndividual ;
    rdfs:label "0.0.0.0:8080" ;
    rdfs:comment "What the listener thread binds: every interface, the port the Worker's defaultPort routes to." .

<https://drift-king.org/ah/cloudflare-pid-rs/content-type>
    a owl:NamedIndividual ;
    rdfs:label "application/json" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc8259> ;
    rdfs:comment "The media type of the status response body." .

<https://drift-king.org/ah/cloudflare-pid-rs/response/body>
    a owl:NamedIndividual ;
    rdfs:label "{{\"pid\": {}, \"started\": \"{}\", \"location\": \"{}\", \"durable_object\": \"{}\"}}" ;
    dcterms:conformsTo <https://doc.rust-lang.org/std/fmt/> ;
    rdfs:comment "The status body: pid, started, location and durable_object, as a std::fmt format string." .

<https://drift-king.org/ah/cloudflare-pid-rs/response/head>
    a owl:NamedIndividual ;
    rdfs:label "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\n\r\n{}" ;
    dcterms:conformsTo <https://doc.rust-lang.org/std/fmt/> ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc9112> ;
    rdfs:comment "The whole HTTP/1.1 response around the body: status line, Content-Type, Content-Length." .

<https://drift-king.org/ah/cloudflare-pid-rs/write-cargo-config>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    dcterms:title "write the cargo config from its template and the setting USERPROFILE" ;
    sd:hasExecutionCommand "node cloudflare-pid-rs/pid1/write-cargo-config.mjs" ;
    dcterms:requires <https://drift-king.org/not-ah/setting/user-profile> , <https://drift-king.org/not-ah/node> .
<https://drift-king.org/ah/cloudflare-pid-rs/build-pid1>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/cloudflare-pid-rs/write-cargo-config> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-bin> ;
    dcterms:title "build pid1.bin" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs/pid1 && cargo zigbuild --release --locked --target x86_64-unknown-linux-musl && cp target/x86_64-unknown-linux-musl/release/pid1 ../pid1.bin" ;
    dcterms:requires <https://drift-king.org/not-ah/rustc> ,
        <https://drift-king.org/not-ah/cargo-zigbuild> ,
        <https://drift-king.org/not-ah/zig> .

<https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-bin>
    a p-plan:Variable ; rdfs:label "pid1.bin" .
<https://drift-king.org/cloudflare-pid-rs/pid1.bin>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-bin> .

<https://drift-king.org/ah/cloudflare-pid-rs/make-layer>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/ah/cloudflare-pid-rs/build-pid1> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-layer-tar> ;
    dcterms:title "make pid1-layer.tar" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs && python make-layer.py pid1.bin pid1-layer.tar" .

<https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-layer-tar>
    a p-plan:Variable ; rdfs:label "pid1-layer.tar" .
<https://drift-king.org/cloudflare-pid-rs/pid1-layer.tar>
    a p-plan:Entity ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/cloudflare-pid-rs/var/pid1-layer-tar> .

<https://drift-king.org/ah/cloudflare-pid-rs/publish-intent>
    a <https://drift-king.org/ah/the-builder/CopyStep> , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:hasOutputVar <https://drift-king.org/ah/cloudflare-pid-rs/var/intent-copy> ;
    dcterms:title "publish the signed letter of intent, byte-exact" .

<https://drift-king.org/ah/cloudflare-pid-rs/var/intent-copy> a p-plan:Variable ; rdfs:label "intent/letter-of-intent.md, published" .

<https://drift-king.org/cloudflare-pid-rs/worker/public/intent/letter-of-intent.md>
    a prov:Entity , p-plan:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://www.iana.org/assignments/media-types/text/markdown> ;
    dcterms:identifier "sha256:0c5ede6bce924501a740c2a130c0db8e04f3ff9235994598e798d66cf3cb94a0" ;
    prov:wasDerivedFrom <https://drift-king.org/intent/letter-of-intent.md> ;
    p-plan:correspondsToVariable <https://drift-king.org/ah/cloudflare-pid-rs/var/intent-copy> ;
    rdfs:comment "Copied byte-exact, sha256-checked by the step that makes it; the step exits 1 on any mismatch. file-provenance.rq (reviewer) sees it as generated, via correspondsToVariable." .

<https://drift-king.org/cloudflare-pid-rs/worker/public/_headers>
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Cloudflare Workers Static Assets reads _headers the same way Pages does (asserted from general knowledge, not yet dug into this repo). /intent/letter-of-intent.md: served as text with Cache-Control no-transform, so nothing between the Worker and the reader can alter the signed bytes." .

<https://drift-king.org/ah/cloudflare-pid-rs/deploy>
    a sd:SoftwareConfiguration , p-plan:Step ;
    p-plan:isStepOfPlan <https://drift-king.org/ah/the-builder/plan> ;
    p-plan:isPrecededBy <https://drift-king.org/not-ah/crane/mutate-pid1> ,
        <https://drift-king.org/ah/cloudflare-pid-rs/ffmpeg-webp> ,
        <https://drift-king.org/ah/cloudflare-pid-rs/ffmpeg-favicons> ,
        <https://drift-king.org/ah/cloudflare-pid-rs/publish-intent> ,
        # A ship step: waits for every check (the chain's last real-step).
        <https://drift-king.org/not-ah/the-linter/terms-defined-in-vocab/real-step> ;
    dcterms:title "deploy the Worker" ;
    sd:hasExecutionCommand "cd cloudflare-pid-rs/worker && sed \"s/CLOUDFLARE_ACCOUNT_ID/${CLOUDFLARE_ACCOUNT_ID:?}/\" wrangler.template.jsonc > wrangler.jsonc && npx --yes wrangler@4.145.0 deploy" ;
    dcterms:requires <https://drift-king.org/not-ah/setting/cloudflare-account-id> ;
    dcterms:requires <https://drift-king.org/not-ah/wrangler> .

# ---------------------------------------------------------------------------
# cloudflare-pid-rs's files. A file is named when its address, the namespace
# plus its path from the repo root, is the subject of something. Each is part
# of cloudflare-pid-rs and says what format it is written in.
# ---------------------------------------------------------------------------
<https://drift-king.org/cloudflare-pid-rs/pid1/src/main.rs> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://doc.rust-lang.org/reference/> .
<https://drift-king.org/cloudflare-pid-rs/pid1/Cargo.toml> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://doc.rust-lang.org/cargo/reference/manifest.html> .
<https://drift-king.org/cloudflare-pid-rs/pid1/Cargo.lock> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Written by cargo, never by hand; committed so builds are --locked." .
<https://drift-king.org/cloudflare-pid-rs/pid1/rust-toolchain.toml> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://rust-lang.github.io/rustup/overrides.html#the-toolchain-file> .
<https://drift-king.org/cloudflare-pid-rs/pid1/.cargo/config.toml> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://doc.rust-lang.org/cargo/reference/config.html> ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/pid1/.cargo/config.template.toml> ;
    rdfs:comment "Written by the step that precedes the build, from the template and the setting USERPROFILE, never by hand and never committed: it holds the paths of the machine that builds." .
<https://drift-king.org/cloudflare-pid-rs/pid1/.cargo/config.template.toml> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://doc.rust-lang.org/cargo/reference/config.html> ;
    rdfs:comment "The cargo config with the places of a machine written as the names CHECKOUT and USERPROFILE. The only part of it that is committed." .
<https://drift-king.org/cloudflare-pid-rs/pid1/write-cargo-config.mjs> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Fills the template from the folder it runs in and the setting USERPROFILE." .
<https://drift-king.org/cloudflare-pid-rs/make-layer.py> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Writes pid1-layer.tar: one entry, pid1, mode 0755, uid and gid 0, mtime 0." .
<https://drift-king.org/cloudflare-pid-rs/worker/src/index.js> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> .
<https://drift-king.org/cloudflare-pid-rs/worker/wrangler.template.jsonc> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://developers.cloudflare.com/workers/wrangler/configuration/> ;
    rdfs:comment "The Worker's configuration, with the account written as the name of its setting. The deploy writes wrangler.jsonc from it, with the setting's value, just before wrangler reads it, and never commits it." .
<https://drift-king.org/cloudflare-pid-rs/worker/wrangler.jsonc> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/worker/wrangler.template.jsonc> ;
    rdfs:comment "Written by the deploy, never by hand and never committed: it holds the account's value." .
<https://drift-king.org/cloudflare-pid-rs/worker/package.json> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:conformsTo <https://docs.npmjs.com/cli/v11/configuring-npm/package-json> .
<https://drift-king.org/cloudflare-pid-rs/worker/package-lock.json> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Written by npm, never by hand." .

