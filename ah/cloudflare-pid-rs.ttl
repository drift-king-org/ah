# ---------------------------------------------------------------------------
# What was built, by identity. Each build output's address is its path; its
# identifier is its hash. Hashes never change, so these never do either: a
# rebuild that hashes differently is a different thing and gets its own node.
# ---------------------------------------------------------------------------
<https://drift-king.org/cloudflare-pid-rs/pid1.bin>
    a prov:Entity , earl:TestSubject ;
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:identifier "sha256:8163ce1cdb728a12c5b3bcaf40a0d5251ba40a8439aa55870b2956b57c2b8d08" ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/pid1/src/main.rs> ;
    rdfs:comment "Static x86-64 ELF, stripped, 434592 bytes. Built with rustc 1.98.1 (commit 48a229cea, the only /rustc/ path embedded in it)." .

<https://drift-king.org/cloudflare-pid-rs/pid1-layer.tar>
    a prov:Entity ;
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:identifier "sha256:369911a5bddca5da201f177341982a64f05c601e95cdb50c6eff971378b1597c" ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/pid1.bin> , <https://drift-king.org/cloudflare-pid-rs/make-layer.py> .

# The image: a stable name, never a digest (M3, iri-names-not-values). Each
# push is a version under it, the digest kept as data (dcterms:identifier),
# not spelled into the IRI. The tag that also points at it moves; neither
# this name nor a version's own name ever does.
<https://drift-king.org/ah/cloudflare-pid-rs/image>
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcterms:hasVersion <https://drift-king.org/ah/cloudflare-pid-rs/image/v1> ,
        <https://drift-king.org/ah/cloudflare-pid-rs/image/v2> ;
    rdfs:comment "What the Worker runs and what a golden would sign." .

# v1: the first push, with a broken entrypoint. Kept on the record, not
# deleted: nothing references it, and deleting by tag would have hit the live
# image.
<https://drift-king.org/ah/cloudflare-pid-rs/image/v1>
    a prov:Entity ;
    dcterms:isVersionOf <https://drift-king.org/ah/cloudflare-pid-rs/image> ;
    dcterms:identifier "sha256:ba0e3474040a45b263ceac576327c3e52332f6c5b78b80722496b599676f1e2c" ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/pid1-layer.tar> ;
    dcterms:isReplacedBy <https://drift-king.org/ah/cloudflare-pid-rs/image/v2> ;
    rdfs:comment "Entrypoint rewritten by Git Bash path conversion before crane saw it. Untagged, unreferenced, left in place." .

# v2: the current push.
<https://drift-king.org/ah/cloudflare-pid-rs/image/v2>
    a prov:Entity , p-plan:Entity , earl:TestSubject ;
    dcterms:isVersionOf <https://drift-king.org/ah/cloudflare-pid-rs/image> ;
    dcterms:identifier "sha256:2c0a8cae7dea4943d408233e6c9d19b8781a1da71fc4ae9b6e97d60e64978459" ;
    prov:wasDerivedFrom <https://drift-king.org/cloudflare-pid-rs/pid1-layer.tar> ;
    p-plan:correspondsToVariable <https://drift-king.org/not-ah/crane/var/image> ;
    rdfs:comment "linux/amd64, entrypoint /pid1, exposes 8080. In registry.cloudflare.com. prov:wasGeneratedBy pointing at mutate-pid1 (a step) is gone (M3): hasOutputVar/correspondsToVariable instead." .

# ---------------------------------------------------------------------------
# What was proven, and when. Each is a test ah defines and a result that was
# seen. Results are facts about a moment: they are added, never edited.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/cloudflare-pid-rs/test/static-elf>
    a earl:TestCase ;
    dcterms:title "pid1.bin is a static x86-64 ELF with no host paths in it" .
<https://drift-king.org/ah/cloudflare-pid-rs/test/sigterm-exit>
    a earl:TestCase ;
    dcterms:title "as PID 1 of its own namespace, SIGTERM makes it print its line and exit 0" .
<https://drift-king.org/ah/cloudflare-pid-rs/test/pid-one-on-cloudflare>
    a earl:TestCase ;
    dcterms:title "on Cloudflare Containers it reports pid 1" .

[ a earl:Assertion ;
  earl:subject <https://drift-king.org/cloudflare-pid-rs/pid1.bin> ;
  earl:test <https://drift-king.org/ah/cloudflare-pid-rs/test/static-elf> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                dcterms:date "2026-09-27"^^xsd:date ] ] .

[ a earl:Assertion ;
  earl:subject <https://drift-king.org/cloudflare-pid-rs/pid1.bin> ;
  earl:test <https://drift-king.org/ah/cloudflare-pid-rs/test/sigterm-exit> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                dcterms:date "2026-09-27"^^xsd:date ] ] .

[ a earl:Assertion ;
  earl:subject <https://drift-king.org/ah/cloudflare-pid-rs/image/v2> ;
  earl:test <https://drift-king.org/ah/cloudflare-pid-rs/test/pid-one-on-cloudflare> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                dcterms:date "2026-09-27T17:40:37Z"^^xsd:dateTime ;
                rdfs:comment "Location cmh01." ] ] .

<https://drift-king.org/ah/cloudflare-pid-rs/test/sigterm-on-cloudflare>
    a earl:TestCase ;
    dcterms:title "on Cloudflare, when the runtime signals a stop, it exits on its own with code 0 within seconds" ;
    rdfs:comment "Passes on exitCode 0 with reason exit. reason runtime_signal means the runtime ended it, which is a failure." .

[ a earl:Assertion ;
  earl:subject <https://drift-king.org/ah/cloudflare-pid-rs/image/v2> ;
  earl:test <https://drift-king.org/ah/cloudflare-pid-rs/test/sigterm-on-cloudflare> ;
  earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                dcterms:date "2026-09-27T18:02:08Z"^^xsd:dateTime ;
                rdfs:comment "Stop signalled 18:02:08.789Z; onStop reported exitCode 0, reason exit, at 18:02:08.878Z: 89 ms." ] ] .

<https://drift-king.org/cloudflare-pid-rs/proof/M5-logs.txt> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Evidence: the stop signal and the onStop exit line, from the Durable Object logs." .

<https://drift-king.org/cloudflare-pid-rs/proof/M6-onstop.txt> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Evidence: pid1 stopped: exitCode=0 reason=exit, 89 ms after the stop signal." .

# Where cloudflare-pid-rs answers. workers.dev is off (workers_dev: false in
# wrangler.jsonc); this custom domain is the only public address. An endpoint
# is a dcat:DataService: dcat:accessURL on the agent itself would retype the
# agent as a dcat:Distribution (domain-retypes caught exactly that).
<https://drift-king.org/ah/cloudflare-pid-rs/endpoint>
    a dcat:DataService ;
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    dcat:endpointURL <https://pid1.drift-king.org/> .


<https://drift-king.org/cloudflare-pid-rs/proof/M8-routing.txt> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Evidence: the routing fix deployed and verified live with three curls, after being caught undeployed." .

<https://drift-king.org/cloudflare-pid-rs/proof/M9-sosa-favicons.txt> dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    rdfs:comment "Evidence: onStop's sosa:Observation and the favicons, deployed and verified live." .

# ---------------------------------------------------------------------------
# The observer. The Worker sees things happen to the container and says so as
# sosa:Observations; it never judges them. Judging is the kernel's: a
# verdict is an earl:Assertion made against a test this model defines.
# ---------------------------------------------------------------------------
<https://drift-king.org/ah/cloudflare-pid-rs/worker>
    a sosa:Sensor ;
    dcterms:isPartOf <https://drift-king.org/ah/cloudflare-pid-rs> ;
    sosa:observes <https://drift-king.org/ah/cloudflare-pid-rs/property/exit> .

<https://drift-king.org/ah/cloudflare-pid-rs/property/exit>
    a sosa:ObservableProperty ;
    rdfs:label "how the container process ended" ;
    rdfs:comment "Reported by the Container class's onStop hook: an exit code and a reason." .

<https://drift-king.org/ah/cloudflare-pid-rs/exitCode>
    a owl:DatatypeProperty ;
    rdfs:label "exitCode" ;
    rdfs:range xsd:integer ;
    rdfs:comment "The container process's exit code, as onStop receives it." .

<https://drift-king.org/ah/cloudflare-pid-rs/reason>
    a owl:DatatypeProperty ;
    rdfs:label "reason" ;
    rdfs:range xsd:string ;
    rdfs:comment "exit when the process ended on its own; runtime_signal when the runtime ended it." .

# pid1 reads a request until the blank line that ends its header section.
<https://drift-king.org/ah/cloudflare-pid-rs/pid1/header-end>
    a owl:NamedIndividual ;
    rdfs:label "\r\n\r\n" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc9112#section-2.1> ;
    rdfs:comment "The end of an HTTP/1.1 request's header section: the last field line's CRLF, then the empty line's." .


# The Worker's own words. index.js may hold a string only if it is named here,
# or is an address; its observation is JSON-LD written in full IRIs, so it
# needs no @context and no compact names.

<https://drift-king.org/ah/cloudflare-pid-rs/worker/sleep-after>
    a owl:NamedIndividual ;
    rdfs:label "5m" ;
    rdfs:isDefinedBy <https://developers.cloudflare.com/containers/> ;
    rdfs:comment "Container.sleepAfter: how long the container stays up with no requests." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/instance>
    a owl:NamedIndividual ;
    rdfs:label "one" ;
    rdfs:isDefinedBy <https://developers.cloudflare.com/durable-objects/api/namespace/> ;
    rdfs:comment "The name of the one Pid1 Durable Object, and so the one container, every request goes to." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/json-ld/type>
    a owl:NamedIndividual ;
    rdfs:label "@type" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/json-ld11/#keywords> .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/json-ld/id>
    a owl:NamedIndividual ;
    rdfs:label "@id" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/json-ld11/#keywords> .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/accept>
    a owl:NamedIndividual ;
    rdfs:label "Accept" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc9110#field.accept> ;
    rdfs:comment "The request header read to decide between the page and the bare status." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/page-media-type>
    a owl:NamedIndividual ;
    rdfs:label "text/html" ;
    rdfs:isDefinedBy <https://www.iana.org/assignments/media-types/text/html> ;
    rdfs:comment "What an Accept header must include to get the page." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/page-method>
    a owl:NamedIndividual ;
    rdfs:label "GET" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc9110#GET> ;
    rdfs:comment "The one request method that gets the page." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/page-path>
    a owl:NamedIndividual ;
    rdfs:label "/" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc3986#section-3.3> ;
    rdfs:comment "The one path that gets the page; every other path goes to pid1." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/no-accept>
    a owl:NamedIndividual ;
    rdfs:label "" ;
    rdfs:comment "What a request with no Accept header reads as: nothing, so it never includes text/html and never gets the page." .


<https://drift-king.org/ah/cloudflare-pid-rs/worker/content-type>
    a owl:NamedIndividual ;
    rdfs:label "content-type" ;
    rdfs:isDefinedBy <https://www.rfc-editor.org/rfc/rfc9110#field.content-type> .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/page-content-type>
    a owl:NamedIndividual ;
    rdfs:label "text/html; charset=utf-8" ;
    rdfs:isDefinedBy <https://www.iana.org/assignments/media-types/text/html> ;
    rdfs:comment "The page's media type, with its charset." .

<https://drift-king.org/ah/cloudflare-pid-rs/worker/page>
    a owl:NamedIndividual ;
    rdfs:label "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Drift King</title>\n<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"32x32\">\n<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n</head>\n<body style=\"margin:0;background:#0b0b0b;color:#eee;font-family:sans-serif;text-align:center;padding:2rem;\">\n<img src=\"/drift-king.webp\" alt=\"Drift King\" style=\"max-width:100%;height:auto;\">\n<pre style=\"text-align:left;display:inline-block;background:#111;padding:1rem;border-radius:8px;\">${JSON.stringify(status, null, 2)}</pre>\n</body>\n</html>" ;
    dcterms:conformsTo <https://tc39.es/ecma262/#sec-template-literals> ;
    rdfs:comment "The status page, as index.js's page() writes it: a template literal whose one hole is the status JSON." .

# The Worker's deploy and every registry step are ship steps: a plain run
# pushes nothing and deploys nothing.
<https://drift-king.org/ah/cloudflare-pid-rs/deploy> a <https://drift-king.org/ah/the-builder/ShipStep> .
<https://drift-king.org/not-ah/crane/login> a <https://drift-king.org/ah/the-builder/ShipStep> .
<https://drift-king.org/not-ah/crane/append-pid1> a <https://drift-king.org/ah/the-builder/ShipStep> .
<https://drift-king.org/not-ah/crane/mutate-pid1> a <https://drift-king.org/ah/the-builder/ShipStep> .
<https://drift-king.org/not-ah/crane/logout> a <https://drift-king.org/ah/the-builder/ShipStep> .
